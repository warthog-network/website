---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Whitepaper & Research";

const papers = [
  {
    title: "Whitepaper",
    description:
      "The complete Warthog Network whitepaper — covers the project's vision, architecture, mining (Janushash/PoBW), DeFi (Fair Batch Matching), tokenomics, and roadmap. Auto-built on every commit to the build branch, always up to date.",
    image: "/Images/whitepaper-preview.png",
    href: "https://github.com/warthog-network/whitepaper/releases/download/build/main.pdf",
  },
  {
    title: "Proof of Balanced Work",
    description:
      "PoBW introduces a novel cryptographic mining paradigm that combines multiple hash functions multiplicatively. This innovation enables hybrid mining algorithms requiring both CPU and GPU capabilities simultaneously, providing strong ASIC-resistance and promoting energy-efficient mining through balanced hardware configurations.",
    image: "/Images/PoBW-preview.png",
    href: "/PoBW.pdf",
  },
  {
    title: "Fair Batch Matching",
    description:
      "FBM is a groundbreaking DeFi matching algorithm that eliminates sandwich attacks and MEV extraction by processing all swap orders jointly within a block. Every participant receives identical pricing regardless of transaction sequence, establishing a Nash equilibrium where manipulation becomes mathematically impossible.",
    image: "/Images/FairBatchMatching-preview.png",
    href: "/FairBatchMatching.pdf",
  },
];
---

<BaseLayout title={title}>
  <div class="research-container">
    <div class="research-header">
      <h1>Whitepaper &amp; Research</h1>
      <p class="subtitle">
        Warthog's whitepaper and research papers represent genuine scientific breakthroughs
        in cryptocurrency, grounded in rigorous mathematical foundations. The core development
        team holds advanced degrees in mathematics, statistics, and computer science from
        top-tier universities.
      </p>
    </div>

    <div class="research-grid">
      {papers.map((paper) => (
        <a href={paper.href} class="research-card" target="_blank" rel="noopener">
          <div class="paper-preview">
            <img src={paper.image} alt={`${paper.title} Preview`} />
            <span class="view-overlay">Click to View</span>
          </div>
          <div class="paper-content">
            <h2>{paper.title}</h2>
            <p>{paper.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .research-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .research-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .research-header h1 {
    font-family: Montserrat, sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: #f8fafc;
    margin-bottom: 1rem;
  }

  .subtitle {
    font-family: Montserrat, sans-serif;
    font-size: 1.1rem;
    font-weight: 400;
    color: rgba(248, 250, 252, 0.85);
    line-height: 1.6;
    max-width: 800px;
    margin: 0 auto;
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .research-card {
    background: rgba(42, 42, 42, 0.8);
    border-radius: 0.75rem;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    display: block;
  }

  .research-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .paper-preview {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1275 / 1651;
  }

  .paper-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .research-card:hover .paper-preview img {
    transform: scale(1.02);
  }

  .view-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: Montserrat, sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #f8fafc;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .research-card:hover .view-overlay {
    opacity: 1;
  }

  .paper-content {
    padding: 1.5rem;
  }

  .paper-content h2 {
    font-family: Montserrat, sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #f8fafc;
    margin-bottom: 0.75rem;
  }

  .paper-content p {
    font-family: Montserrat, sans-serif;
    font-size: 0.938rem;
    font-weight: 400;
    line-height: 1.6;
    color: rgba(248, 250, 252, 0.85);
  }

  @media (max-width: 850px) {
    .research-grid {
      grid-template-columns: 1fr;
    }

    .research-container {
      padding: 1rem;
    }

    .research-header h1 {
      font-size: 2rem;
    }
  }
</style>
