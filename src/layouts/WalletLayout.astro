---
import '../blogstyles.css';
import '../styles.css';
import BaseHead from '../components/BaseHead.astro';
const {title} = Astro.props;
// import Footer from "../components/Footer.astro";
 import Footer from "../components/FooterTailwind.astro";
---

<html lang="en">
	<head>
        <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wallet</title>
    <!-- PWA-specific links -->
    <link rel="manifest" href="/webwallet/manifest.json" />
    <!-- Add theme color or other meta for PWA -->
    <meta name="theme-color" content="#070707" />
    <meta name="color-scheme" content="dark" />
    <!-- Script to register the service worker -->

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.png" sizes="any" type="image/png" />
<link rel="apple-touch-icon" href="/favicon.png" />
    <style>
      .navbarclass button:focus {
        outline: none;
      }
    </style>
  </head>

	<body class="site-body site-body--wartbunker">
    {/* above, make it possible to place footer at botton even if 
    content is not big enough, it is useful for embedding PDF such that the embed height is just as much that the page height is exactly fitting in view port*/}
		 <BaseHead id="app-header" class="navbarclass" />
        <main id="main-content" class="site-main">
            <slot />
        </main>
        
        <footer id="app-footer">
 
             <Footer/>
                     <script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      // Drop legacy root SW that intercepted all site assets in dev
      navigator.serviceWorker.getRegistrations().then((registrations) => {
        registrations.forEach((reg) => {
          const script = reg.active?.scriptURL || '';
          if (script.endsWith('/sw.js') && !script.includes('/webwallet/')) {
            reg.unregister();
          }
        });
      });
    });
  }
    import "../scripts/menu.js";
              document.addEventListener('DOMContentLoaded', () => {
            const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (navigator.standalone === true);
            const isMobile = window.innerWidth < 768; // Adjust breakpoint as needed (e.g., 768px for tablets/mobile)
            const header = document.getElementById('app-header');
            const footer = document.getElementById('app-footer');

            if (isMobile && isStandalone) {
              if (header) header.style.display = 'none';
              if (footer) footer.style.display = 'none';
            }
          });
</script>
        </footer>
 
	</body>
</html>
