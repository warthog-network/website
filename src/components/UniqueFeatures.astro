      },
      {
        title: "0% Team Allocation",
        copy: "There are no reserved dev funds, dev fees, hidden allocations or advisor carve-outs. Development is based on enthusiasts, community and donations.",
        iconSrc: Profile.src,
      },
      {
        title: "100% Minable",
        copy: "Every WART is publicly mineable by the community. The hard cap of no more than 19 million coins to ever be mined makes Warthog scarcer than Bitcoin.",
        iconSrc: Trolly.src,
      },
    ],
  },
  {
    id: "original-code",
    title: "Original Code",
    status: "live",
    lede: "No Bitcoin fork. No copy-paste stack. Warthog was written from scratch with a modern toolchain, and the choices that fall out of that decision are visible in every corner of the codebase.",
    points: [
      {
        title: "Written from Scratch",
        copy: "Warthog is no fork of any other project. The code was carefully from ground up by humans with real commitment, love and dedication. This is no burner project.",
