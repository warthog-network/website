<unique-features-panel
  class="section unique-section"
  id="unique"
  {...(buildHash ? { "data-build": buildHash } : {})}
>
  <div class="unique-section__backdrop" aria-hidden="true"></div>
  <div class="unique-section__overlay" aria-hidden="true"></div>

  <div class="unique-section__content">
    <div class="features-intro">
      <p class="section__eyebrow">What makes us unique</p>
      <h2 class="section__title">Built with purpose</h2>
    </div>

    <div class="features-layout">
      <div class="features-rail" aria-label="Feature progress">
        <div class="features-rail__track" aria-hidden="true">
          <div class="features-rail__fill"></div>
        </div>
        <div class="features-rail__nodes">
          {categories.map((_, index) => (
            <button
              type="button"
              class:list={["features-rail__node", { "is-lit": index === 0, "is-active": index === 0 }]}
              data-rail={index}
              aria-label={`Show ${categories[index].title}`}
              aria-current={index === 0 ? "true" : undefined}
            />
          ))}
        </div>
      </div>

      <div class="features-nav-mobile">
        <p class="label-features">Features</p>
        <div class="features-nav-dropdown">
          <button
            type="button"
            class="features-nav-chip features-nav-dropdown__trigger"
            aria-expanded="false"
            aria-haspopup="listbox"
            aria-label="Choose a feature category"
          >
            <span class="features-nav-chip__dot" aria-hidden="true"></span>
            <span class="features-nav-dropdown__label features-nav-chip__label">{categories[0].title}</span>
            <span class="features-nav-dropdown__chevron" aria-hidden="true"></span>
          </button>
          <ul class="features-nav-dropdown__menu" role="listbox" aria-label="Feature categories">
            {categories.map((category, index) => (
              <li>
                <a
                  href={`#unique-${category.id}`}
                  class:list={["features-nav-chip", "features-nav-dropdown__option", { "is-active": index === 0 }]}
                  role="option"
                  data-nav-mobile={index}
                  data-label={category.title}
                  aria-selected={index === 0 ? "true" : "false"}
                >
                  <span class="features-nav-chip__dot" aria-hidden="true"></span>
                  <span class="features-nav-chip__label">{category.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="features-card-stack">
        <button
          type="button"
          class="features-card-arrow features-card-arrow--prev"
          data-card-arrow="prev"
          aria-label="Previous feature card"
          disabled
        ></button>

        <div
          class="features-view"
          tabindex="0"
          aria-label="Feature cards. Swipe up or down, use arrows, scroll, or arrow keys to change card."
        >
          {categories.map((category, index) => (
            <article
              id={`unique-${category.id}`}
              class:list={["feature-card", { "is-active": index === 0 }]}
              data-card={index}
              hidden={index !== 0}
              aria-hidden={index !== 0 ? "true" : "false"}
            >
              <div class="feature-card__meta">
                <div class="feature-card__meta-start">
                  <span class="feature-card__height">#{String(index + 1).padStart(4, "0")}</span>
                  <code class="feature-card__hash">0x{category.id.slice(0, 8)}…</code>
                </div>
                {category.status && (
                  <span class={`category-card__badge category-card__badge--${category.status}`}>
                    {category.status}
                  </span>
                )}
              </div>
              <header class="category-card__header">
                <h3 class="category-card__title">{category.title}</h3>
                <p class="category-card__lede">{category.lede}</p>
              </header>
              <div class="category-points">
                {category.points.map((point) => (
                  <div class="point" role="button" tabindex="0">
                    <h4 class="point__title">
                      {"iconSrc" in point && point.iconSrc ? (
                        "iconSlashed" in point && point.iconSlashed ? (
                          <span class="point__icon point__icon--slashed">
                            <img
                              src={point.iconSrc}
                              alt=""
                              class="point__icon--asset"
                              width="22"
                              height="22"
                              loading="lazy"
                            />
                          </span>
                        ) : (
                          <span class="point__icon">
                            <img
                              src={point.iconSrc}
                              alt=""
                              class="point__icon--asset"
                              width="22"
                              height="22"
                              loading="lazy"
                            />
                          </span>
                        )
                      ) : (
                        <span
                          class:list={[
                            "point__icon",
                            { "point__icon--slashed": "iconSlashed" in point && point.iconSlashed },
                          ]}
                          set:html={featurePointIcons[point.icon as FeaturePointIconName]}
                        />
                      )}
                      {point.title}
                    </h4>
                    <p class="point__copy">{point.copy}</p>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>

        <button
          type="button"
          class="features-card-arrow features-card-arrow--next"
          data-card-arrow="next"
          aria-label="Next feature card"
        ></button>
      </div>

      <div class="features-nav-wrap">
        <p class="label-features">Features</p>
        <nav class="features-nav" aria-label="Feature categories">
          {categories.map((category, index) => (
            <a
              href={`#unique-${category.id}`}
              class:list={["features-nav__item", { "is-active": index === 0 }]}
              data-nav={index}
              aria-current={index === 0 ? "true" : undefined}
            >
              <span class="features-nav__dot" aria-hidden="true"></span>
              <span class="features-nav__label">{category.title}</span>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</unique-features-panel>