    ],
  },
  {
    id: "pobw",
    title: "Janushash",
    status: "live",
    lede: "Our mathematical Proof of Balanced Work (PoBW) theory cleanly combines Verushash v2.2 and Sha256t into Warthog's unique Janushash algorithm desgined to bring back the golden days of mining.",
    points: [
      {
        title: "Repelling Farms",
        copy: "The required balanced combination of Verushash v2.2 and SHA256t bottlenecks pure GPU farms, pure CPU farms and botnets. Efficient mining requires decent CPU and GPU hashrates, which farms rarely support.",
        icon: "repelFarms",
        iconSlashed: true,
