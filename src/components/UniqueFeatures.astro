];
---

<script>
  class UniqueFeaturesPanel extends HTMLElement {
    connectedCallback() {
      this.navButtons = Array.from(this.querySelectorAll("[data-nav]"));
      this.railButtons = Array.from(this.querySelectorAll("[data-rail]"));
      this.cards = Array.from(this.querySelectorAll("[data-card]"));
      this.featuresView = this.querySelector(".features-view");
      this.cardArrowPrev = this.querySelector("[data-card-arrow='prev']");
      this.cardArrowNext = this.querySelector("[data-card-arrow='next']");
      this.railFill = this.querySelector(".features-rail__fill");
      this.featureIndexById = new Map(
        this.cards.map((card, index) => [card.id, index]),
      );
      this.activeIndex = 0;
      this.syncingHash = false;
      this.isTransitioning = false;
      this.transitionTimer = 0;
      this.transitionMs = 620;
      this.prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      this.isHovering = false;
      this.wheelLocked = false;
      this.wheelUnlockTimer = 0;
      this.touchStartY = 0;
      this.touchStartX = 0;
      this.touchLocked = false;
      this.touchUnlockTimer = 0;

      this.onWheel = (event) => {
        if (!this.isHovering || this.wheelLocked || this.isTransitioning) return;

        if (event.deltaY > 8 && this.activeIndex < this.cards.length - 1) {
          event.preventDefault();
          this.stepCard(1);
        } else if (event.deltaY < -8 && this.activeIndex > 0) {
          event.preventDefault();
          this.stepCard(-1);
        }
      };

      this.onKeydown = (event) => {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          this.stepCard(1);
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          this.stepCard(-1);
        }
      };

      this.onTouchStart = (event) => {
        if (event.touches.length !== 1 || this.touchLocked || this.isTransitioning) return;
        this.touchStartY = event.touches[0].clientY;
        this.touchStartX = event.touches[0].clientX;
      };

      this.onTouchEnd = (event) => {
        if (this.touchLocked || this.isTransitioning) return;

        const touch = event.changedTouches[0];
        if (!touch) return;

        const deltaY = this.touchStartY - touch.clientY;
        const deltaX = this.touchStartX - touch.clientX;
        const swipeThreshold = 48;

        if (Math.abs(deltaY) < swipeThreshold || Math.abs(deltaX) > Math.abs(deltaY) * 0.85) return;

        if (deltaY > 0 && this.activeIndex < this.cards.length - 1) {
          this.stepCard(1);
        } else if (deltaY < 0 && this.activeIndex > 0) {
          this.stepCard(-1);
        }
      };

      this.navDropdown = this.querySelector(".features-nav-dropdown");
      this.navDropdownTrigger = this.querySelector(".features-nav-dropdown__trigger");
      this.navDropdownLabel = this.querySelector(".features-nav-dropdown__label");
      this.navDropdownOptions = Array.from(this.querySelectorAll("[data-nav-mobile]"));

      this.onDocumentClick = (event) => {
        if (!this.navDropdown?.contains(event.target)) {
          this.closeNavDropdown();
        }
      };

      this.navDropdownTrigger?.addEventListener("click", () => {
        const isOpen = this.navDropdown?.classList.toggle("is-open");
        this.navDropdownTrigger?.setAttribute("aria-expanded", isOpen ? "true" : "false");
      });

      this.navDropdownOptions.forEach((button) => {
        button.addEventListener("click", (event) => {
          event.preventDefault();
          this.activate(Number(button.dataset.navMobile));
          this.closeNavDropdown();
        });
      });

      document.addEventListener("click", this.onDocumentClick);

      this.onHashChange = () => {
        if (this.syncingHash) return;
        this.activateFromHash({ scroll: true, animate: false });
      };

      this.navButtons.forEach((button) => {
        button.addEventListener("click", (event) => {
          event.preventDefault();
          this.activate(Number(button.dataset.nav));
        });
      });

      this.railButtons.forEach((button) => {
        button.addEventListener("click", () => this.activate(Number(button.dataset.rail)));
      });

      this.cardArrowPrev?.addEventListener("click", () => this.stepCard(-1));
      this.cardArrowNext?.addEventListener("click", () => this.stepCard(1));

      this.featuresView?.addEventListener("mouseenter", () => {
        this.isHovering = true;
      });
      this.featuresView?.addEventListener("mouseleave", () => {
        this.isHovering = false;
      });
      this.featuresView?.addEventListener("wheel", this.onWheel, { passive: false });
      this.featuresView?.addEventListener("keydown", this.onKeydown);
      this.featuresView?.addEventListener("touchstart", this.onTouchStart, { passive: true });
      this.featuresView?.addEventListener("touchend", this.onTouchEnd, { passive: true });

      this.setupPointExpansion();
      this.activateFromHash({ scroll: Boolean(window.location.hash), animate: false });
      window.addEventListener("hashchange", this.onHashChange);
    }

    disconnectedCallback() {
      this.featuresView?.removeEventListener("wheel", this.onWheel);
      this.featuresView?.removeEventListener("keydown", this.onKeydown);
      this.featuresView?.removeEventListener("touchstart", this.onTouchStart);
      this.featuresView?.removeEventListener("touchend", this.onTouchEnd);
      document.removeEventListener("click", this.onDocumentClick);
      window.removeEventListener("hashchange", this.onHashChange);
      clearTimeout(this.wheelUnlockTimer);
      clearTimeout(this.touchUnlockTimer);
      clearTimeout(this.transitionTimer);
    }

    getIndexFromHash(hash = window.location.hash) {
      const slug = hash.replace(/^#/, "");
      if (!slug || slug === "unique") return -1;
      const featureId = slug.startsWith("unique-") ? slug : `unique-${slug}`;
      return this.featureIndexById.get(featureId) ?? -1;
    }

    updateHash(index) {
      const card = this.cards[index];
      if (!card?.id) return;

      const nextHash = `#${card.id}`;
      if (window.location.hash === nextHash) return;

      this.syncingHash = true;
      history.replaceState(null, "", `${window.location.pathname}${window.location.search}${nextHash}`);
      this.syncingHash = false;
    }

    scrollToFeature(index) {
      const target = this.cards[index] ?? this;
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    activateFromHash({ scroll = false, animate = true } = {}) {
      const index = this.getIndexFromHash();
      if (index < 0) {
        if (window.location.hash === "#unique") {
          this.scrollIntoView({ behavior: "smooth", block: "start" });
        } else {
          this.update();
        }
        return;
      }

      if (index === this.activeIndex && !scroll) {
        this.update();
        return;
      }

      if (!animate || this.prefersReducedMotion) {
        this.activeIndex = index;
        this.update();
        this.updateHash(index);
        if (scroll) this.scrollToFeature(index);
        return;
      }

      this.activate(index);
      if (scroll) {
        window.requestAnimationFrame(() => this.scrollToFeature(index));
      }
    }

    closeNavDropdown() {
      this.navDropdown?.classList.remove("is-open");
      this.navDropdownTrigger?.setAttribute("aria-expanded", "false");
    }

    activate(index, explicitDirection) {
      const nextIndex = Math.max(0, Math.min(index, this.cards.length - 1));
      if (nextIndex === this.activeIndex || this.isTransitioning) return;

      if (this.prefersReducedMotion) {
        this.activeIndex = nextIndex;
        this.update();
        this.updateHash(nextIndex);
        return;
      }

      const direction =
        explicitDirection ?? (nextIndex > this.activeIndex ? 1 : nextIndex < this.activeIndex ? -1 : 0);
      this.transitionTo(nextIndex, direction);
    }

    stepCard(delta) {
      if (this.isTransitioning) return;
      this.activate(this.activeIndex + delta, delta);

      this.wheelLocked = true;
      this.touchLocked = true;
      clearTimeout(this.wheelUnlockTimer);
      clearTimeout(this.touchUnlockTimer);
      const unlockDelay = 720;
      this.wheelUnlockTimer = window.setTimeout(() => {
        this.wheelLocked = false;
      }, unlockDelay);
      this.touchUnlockTimer = window.setTimeout(() => {
        this.touchLocked = false;
      }, unlockDelay);
    }

    clearCardMotionClasses(card) {
      card.classList.remove(
        "is-leaving",
        "is-leaving-to-top",
        "is-leaving-to-bottom",
        "is-entering",
        "is-entering-from-top",
        "is-entering-from-bottom",
      );
    }

    transitionTo(nextIndex, direction) {
      if (this.isTransitioning) return;

      const prevIndex = this.activeIndex;
      const outgoing = this.cards[prevIndex];
      const incoming = this.cards[nextIndex];
      if (!outgoing || !incoming) return;

      this.isTransitioning = true;
      this.activeIndex = nextIndex;

      const leaveClass = direction > 0 ? "is-leaving-to-top" : "is-leaving-to-bottom";
      const enterClass = direction > 0 ? "is-entering-from-bottom" : "is-entering-from-top";

      this.clearCardMotionClasses(outgoing);
      this.clearCardMotionClasses(incoming);

      this.collapsePoints(outgoing);

      outgoing.classList.remove("is-active");
      outgoing.classList.add("is-leaving", leaveClass);
      outgoing.removeAttribute("hidden");
      outgoing.setAttribute("aria-hidden", "true");

      incoming.classList.add("is-active", "is-entering", enterClass);
      incoming.removeAttribute("hidden");
      incoming.setAttribute("aria-hidden", "false");

      this.syncChrome();

      clearTimeout(this.transitionTimer);
      this.transitionTimer = window.setTimeout(() => {
        this.clearCardMotionClasses(outgoing);
        outgoing.toggleAttribute("hidden", true);

        this.clearCardMotionClasses(incoming);
        incoming.classList.add("is-active");

        this.isTransitioning = false;
        this.updateHash(nextIndex);
      }, this.transitionMs);
    }

    collapsePoints(card) {
      card.classList.remove("has-expanded-point");
      card.querySelectorAll(".point.is-expanded").forEach((point) => {
        point.classList.remove("is-expanded");
      });
    }

    setupPointExpansion() {
      this.cards.forEach((card) => {
        card.querySelectorAll(".point").forEach((point) => {
          const toggle = () => {
            const wasExpanded = point.classList.contains("is-expanded");
            this.collapsePoints(card);

            if (!wasExpanded) {
              point.classList.add("is-expanded");
              card.classList.add("has-expanded-point");
            }
          };

          point.addEventListener("click", toggle);
          point.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              toggle();
            }
          });
        });
      });
    }

    syncChrome() {
      const lastIndex = Math.max(this.cards.length - 1, 1);
      const progress = (this.activeIndex / lastIndex) * 100;

      this.navButtons.forEach((button, index) => {
        const isActive = index === this.activeIndex;
        button.classList.toggle("is-active", isActive);
        if (isActive) {
          button.setAttribute("aria-current", "true");
        } else {
          button.removeAttribute("aria-current");
        }
      });

      this.railButtons.forEach((button, index) => {
        const isActive = index === this.activeIndex;
        const isLit = index <= this.activeIndex;
        button.classList.toggle("is-active", isActive);
        button.classList.toggle("is-lit", isLit);
        if (isActive) {
          button.setAttribute("aria-current", "true");
        } else {
          button.removeAttribute("aria-current");
        }
      });

      if (this.railFill) {
        this.railFill.style.height = `${progress}%`;
      }

      if (this.navDropdownLabel) {
        this.navDropdownLabel.textContent =
          this.navDropdownOptions[this.activeIndex]?.dataset.label ?? "";
      }

      this.navDropdownOptions.forEach((button, index) => {
        const isActive = index === this.activeIndex;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-selected", isActive ? "true" : "false");
      });

      if (this.cardArrowPrev) {
        const atStart = this.activeIndex === 0;
        this.cardArrowPrev.disabled = atStart;
        this.cardArrowPrev.setAttribute("aria-disabled", atStart ? "true" : "false");
      }

      if (this.cardArrowNext) {
        const atEnd = this.activeIndex >= this.cards.length - 1;
        this.cardArrowNext.disabled = atEnd;
        this.cardArrowNext.setAttribute("aria-disabled", atEnd ? "true" : "false");
      }
    }

    update() {
      this.cards.forEach((card, index) => {
        const isActive = index === this.activeIndex;
        this.clearCardMotionClasses(card);
        card.classList.toggle("is-active", isActive);
        card.toggleAttribute("hidden", !isActive);
        card.setAttribute("aria-hidden", isActive ? "false" : "true");
        if (!isActive) {
          this.collapsePoints(card);
        }
      });

      this.syncChrome();
    }
  }

  customElements.define("unique-features-panel", UniqueFeaturesPanel);
</script>

<style>
  .unique-section {
    position: relative;
    isolation: isolate;
    overflow-x: hidden;
    overflow-y: visible;
    margin-top: clamp(-2.5rem, -5vw, -4rem);
    margin-bottom: 0;
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--color-bg);
    scroll-margin-top: 5.5rem;
  }

  .unique-section.section {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .unique-section__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: transparent;
    background-image:
      radial-gradient(ellipse 130% 36% at 50% 44%, rgba(88, 28, 135, 0.17), transparent 72%),
      radial-gradient(ellipse 85% 24% at 68% 46%, rgba(236, 72, 153, 0.1), transparent 66%),
      radial-gradient(ellipse 75% 20% at 26% 42%, rgba(56, 189, 248, 0.07), transparent 62%),
      radial-gradient(ellipse 110% 28% at 50% 52%, rgba(192, 132, 252, 0.08), transparent 70%);
    background-repeat: no-repeat;
    background-size: 100% 100%;
    pointer-events: none;
  }

  .unique-section__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, var(--color-bg) 0%, transparent 9%);
    pointer-events: none;
  }

  .unique-section__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  html.build-mark-on .unique-section[data-build]::after {
    content: "unique-features · " attr(data-build);
    position: absolute;
    left: 50%;
    bottom: 0.35rem;
    translate: -50% 0;
    z-index: 4;
    pointer-events: none;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
    opacity: 0.65;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(56, 189, 248, 0.3);
    background: rgba(1, 3, 10, 0.6);
  }

  .features-intro {
    text-align: center;
    margin: 0 auto clamp(1.5rem, 3vw, 2.25rem);
    max-width: 800px;
  }

  .features-intro h2 {
    margin: 0.35rem 0 0;
  }

  .features-layout {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .features-rail {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 2rem;
    min-height: 420px;
    align-self: stretch;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
  }

  .features-rail__track {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 50%;
    width: 2px;
    translate: -50% 0;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    overflow: hidden;
  }

  .features-rail__fill {
    width: 100%;
    height: 0%;
    background: linear-gradient(to bottom, var(--color-brand), var(--color-accent));
    border-radius: inherit;
  }

  .features-rail__nodes {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    width: 100%;
  }

  .features-rail__node {
    width: 0.65rem;
    height: 0.65rem;
    margin-inline: auto;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.15);
    cursor: pointer;
  }

  .features-rail__node.is-lit {
    background: var(--color-brand);
    box-shadow: 0 0 0 2px rgba(253, 185, 19, 0.5);
  }

  .features-rail__node.is-active {
    scale: 1.35;
    box-shadow:
      0 0 0 2px rgba(253, 185, 19, 0.5),
      0 0 12px rgba(253, 185, 19, 0.65);
  }

  .features-rail__node:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .label-features {
    margin: 0 0 0.5rem;
    font-size: 0.68rem;
    font-weight: 600;
