<unique-features-chain class="section unique-section" id="unique">
  <div class="unique-section__backdrop" aria-hidden="true"></div>
  <div class="unique-section__overlay" aria-hidden="true"></div>

  <div class="unique-section__content">
    <div class="chain-scroll-pin">
      <div class="chain-pin-track">
      <div class="chain-stage">
        <div class="features-intro">
          <p class="section__eyebrow">What makes us unique</p>
          <h2 class="section__title">Built different, on purpose</h2>
        </div>

        <div class="chain-stage__body">
        <div class="chain-rail" aria-hidden="true">
          <div class="chain-rail__track"><div class="chain-rail__fill"></div></div>
          <div class="chain-rail__nodes">
            {categories.map((_, index) => (
              <div class:list={["chain-rail__node", { "is-lit": index === 0, "is-active": index === 0 }]} />
            ))}
          </div>
        </div>

        <div class="chain-viewport">
          <div class="chain-track">
            {categories.map((category, index) => (
              <article
                class:list={["chain-block", { "is-active": index === 0 }]}
                data-block-index={index}
                aria-hidden={index !== 0 ? "true" : "false"}
              >
                <div class="chain-block__meta">
                  <span class="chain-block__height">#{String(index + 1).padStart(4, "0")}</span>
                  <code class="chain-block__hash">0x{category.id.slice(0, 8)}…</code>
                  <span class="chain-block__status">{index === 0 ? "LIVE" : "PENDING"}</span>
                </div>
                <header class="category-card__header">
                  <div class="category-card__title-row">
                    <h3 class="category-card__title">{category.title}</h3>
                    {category.status && (
                      <span class={`category-card__badge category-card__badge--${category.status}`}>
                        {category.status}
                      </span>
                    )}
                  </div>
                  <p class="category-card__lede">{category.lede}</p>
                </header>
                <div class="category-points">
                  {category.points.map((point) => (
                    <div class="point">
                      <h4 class="point__title">
                        <img src={point.icon} alt="" class="point__icon" loading="lazy" />
                        {point.title}
                      </h4>
                      <p class="point__copy">{point.copy}</p>
                    </div>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>

        <nav class="chain-nav" aria-label="Feature categories">
          {categories.map((category, index) => (
            <div class:list={["chain-nav__item", { "is-active": index === 0 }]} data-nav={index}>
              <span class="chain-nav__dot" aria-hidden="true"></span>
              <span class="chain-nav__label">{category.title}</span>
            </div>
          ))}
        </nav>
        </div>
      </div>
      </div>
      <div class="chain-exit-track" aria-hidden="true"></div>
    </div>
  </div>
</unique-features-chain>