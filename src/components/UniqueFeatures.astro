    points: [
      {
        title: "In-Browser",
        copy: "Careful code design allows swapping the transport layer between TCP, Websocket and WebRTC such that Emscripten easily compiles the full node to Webassembly to run within the browser as simple as opening a website.",
        icon: Browsers.src,
      },
      {
        title: "Persistence",
        copy: "Modern Browsers support the Origin Private File System (OPFS) to save gigabytes of data. We make use of SQLite's recently added OPFS support to directly operate and save the block chain in the browser.",
        icon: P2P.src,
      },
      {
        title: "P2P Support",
        copy: "Direct browser-to-browser communication is be done over WebRTC. After the handshake, no intermediate server is required. Bridge nodes interconnect WebRTC browser nodes to the TCP based rest of the network.",
        icon: P2P.src,
      },
    ],
  },
];
---

<script>
  import { gsap } from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const SCROLL_PER_BLOCK = 0.88;
  const END_HOLD = 0.65;
  const END_EXIT = 0.28;
  const END_DWELL = END_HOLD + END_EXIT;
  const BLOCK_GAP = 28;

  class UniqueFeaturesChain extends HTMLElement {
    constructor() {
      super();
      this.scrollTriggers = [];
      this.resizeObserver = null;
      this.reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      this.onReducedMotionChange = () => this.setup();
    }

    connectedCallback() {
      this.reducedMotion.addEventListener("change", this.onReducedMotionChange);
      this.setup();
    }

    disconnectedCallback() {
      this.reducedMotion.removeEventListener("change", this.onReducedMotionChange);
      this.teardown();
    }

    teardown() {
      this.scrollTriggers.forEach((trigger) => trigger.kill());
      this.scrollTriggers = [];
      this.resizeObserver?.disconnect();
      this.resizeObserver = null;
    }

    setup() {
      this.teardown();

      const backdrop = this.querySelector(".unique-section__backdrop");
      if (backdrop) {
        const backdropTween = gsap.to(backdrop, {
          backgroundPosition: "50% 100%",
          ease: "none",
          scrollTrigger: {
            trigger: this,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
            invalidateOnRefresh: true,
          },
        });
        this.scrollTriggers.push(backdropTween.scrollTrigger);
      }

      const blocks = this.querySelectorAll(".chain-block");

      if (this.reducedMotion.matches) {
        this.classList.add("is-static");
        blocks.forEach((block) => {
          block.classList.add("is-active");
          block.setAttribute("aria-hidden", "false");
        });
        return;
      }

      this.classList.remove("is-static");

      const scrollPin = this.querySelector(".chain-scroll-pin");
      const pinTrack = this.querySelector(".chain-pin-track");
      const exitTrack = this.querySelector(".chain-exit-track");
      const stage = this.querySelector(".chain-stage");
      const stageBody = this.querySelector(".chain-stage__body");
      const viewport = this.querySelector(".chain-viewport");
      const track = this.querySelector(".chain-track");
      const sectionBackdrop = this.querySelector(".unique-section__backdrop");
      const sectionOverlay = this.querySelector(".unique-section__overlay");
      const railFill = this.querySelector(".chain-rail__fill");
      const nodes = this.querySelectorAll(".chain-rail__node");
      const indicators = this.querySelectorAll(".chain-nav__item");

      if (
        !scrollPin ||
        !pinTrack ||
        !exitTrack ||
        !stage ||
        !stageBody ||
        !viewport ||
        !track ||
        !blocks.length
      ) {
        return;
      }

      const blockCount = blocks.length;
      let blockOffsets = [];
      let chainTrigger = null;
      let exitTrigger = null;

      const updateLayout = () => {
        const bodyStyles = getComputedStyle(stageBody);
        const padX =
          parseFloat(bodyStyles.paddingLeft) + parseFloat(bodyStyles.paddingRight);
        const padY =
          parseFloat(bodyStyles.paddingTop) + parseFloat(bodyStyles.paddingBottom);
        const navSpace = window.innerWidth >= 900 ? 120 : 0;
        const railSpace = window.innerWidth >= 640 ? 48 : 0;
        const availableWidth = Math.max(
          stageBody.clientWidth - padX - navSpace - railSpace,
          280
        );
        const availableHeight = Math.max(stageBody.clientHeight - padY, 280);
        const isMobile = window.innerWidth < 900;

        const width = isMobile
          ? Math.round(availableWidth)
          : Math.round(Math.min(availableWidth * 0.98, 1000));

        let maxBlockHeight = 0;
        blocks.forEach((block) => {
          maxBlockHeight = Math.max(maxBlockHeight, block.offsetHeight);
        });
        const viewportHeight = isMobile
          ? Math.round(Math.min(maxBlockHeight + 8, availableHeight * 0.92))
          : Math.round(Math.min(availableHeight * 0.82, 620));

        viewport.style.width = `${width}px`;
        viewport.style.height = `${viewportHeight}px`;

        blockOffsets = [];
        let cumulativeOffset = 0;
        blocks.forEach((block, index) => {
          blockOffsets.push(cumulativeOffset);
          cumulativeOffset += block.offsetHeight;
          if (index < blockCount - 1) {
            cumulativeOffset += BLOCK_GAP;
          }
        });

        scrollPin.style.setProperty("--block-count", String(blockCount));
        scrollPin.style.setProperty(
          "--scroll-per-block",
          `${Math.round(SCROLL_PER_BLOCK * 100)}svh`
        );
        scrollPin.style.setProperty(
          "--end-dwell",
          `${Math.round(END_DWELL * 100)}svh`
        );
      };

      const getContentRatio = () => {
        const contentDistance = (blockCount - 1) * SCROLL_PER_BLOCK;
        const totalDistance = contentDistance + END_DWELL;
        return totalDistance > 0 ? contentDistance / totalDistance : 1;
      };

      const mapScrollProgress = (progress) =>
        Math.min(1, progress / getContentRatio());

      const getInterpolatedValue = (floatIndex, getValue) => {
        const lower = Math.floor(floatIndex);
        const upper = Math.min(Math.ceil(floatIndex), blockCount - 1);
        if (lower === upper) return getValue(lower);
        const t = floatIndex - lower;
        return getValue(lower) + (getValue(upper) - getValue(lower)) * t;
      };

      const getExitProgress = (rawProgress) => {
        const contentRatio = getContentRatio();
        const dwellSpan = 1 - contentRatio;
        if (dwellSpan <= 0 || END_EXIT <= 0) return 0;

        const dwellProgress = Math.min(
          1,
          Math.max(0, (rawProgress - contentRatio) / dwellSpan)
        );
        const holdFraction = END_HOLD / END_DWELL;
        if (dwellProgress <= holdFraction) return 0;

        const exitSpan = 1 - holdFraction;
        return Math.min(1, (dwellProgress - holdFraction) / exitSpan);
      };

      const updateScrollState = (progress, rawProgress = progress) => {
        const floatIndex = progress * (blockCount - 1);
        const activeIndex = Math.min(Math.round(floatIndex), blockCount - 1);
        const exitProgress = getExitProgress(rawProgress);
        const isExiting = exitProgress > 0;
        const viewportHeight = viewport.clientHeight;
        const blockOffset = getInterpolatedValue(
          floatIndex,
          (index) => blockOffsets[index] ?? 0
        );
        const blockHeight = getInterpolatedValue(
          floatIndex,
          (index) => blocks[index]?.offsetHeight || 0
        );
        const centerY = Math.max(0, viewportHeight / 2 - blockHeight / 2);
        const targetY = centerY - blockOffset;

        gsap.set(track, { y: targetY });

        const railProgress = progress * (1 - exitProgress);
        if (railFill) {
          railFill.style.height = `${railProgress * 100}%`;
        }

        const uiOpacity = 1 - exitProgress;

        nodes.forEach((node, i) => {
          const isLit = i <= activeIndex && !isExiting;
          const isNodeActive = i === activeIndex && !isExiting;
          node.classList.toggle("is-lit", isLit);
          node.classList.toggle("is-active", isNodeActive);
          gsap.set(node, { opacity: uiOpacity });
        });

        indicators.forEach((indicator, i) => {
          const isIndicatorActive = i === activeIndex && !isExiting;
          indicator.classList.toggle("is-active", isIndicatorActive);
          gsap.set(indicator, { opacity: uiOpacity });
        });

        blocks.forEach((block, i) => {
          const dist = Math.abs(i - floatIndex);
          const isLastBlock = i === blockCount - 1;
          const isActive = i === activeIndex && !isExiting;
          const isSynced = i < activeIndex || (isLastBlock && isExiting);

          block.classList.toggle("is-active", isActive);
          block.classList.toggle("is-synced", isSynced);
          block.classList.toggle("is-pending", i > activeIndex);
          block.setAttribute("aria-hidden", isActive ? "false" : "true");

          const statusEl = block.querySelector(".chain-block__status");
          if (statusEl) {
            if (isActive) {
              statusEl.textContent = "LIVE";
            } else if (isSynced) {
              statusEl.textContent = "SYNCED";
            } else {
              statusEl.textContent = "PENDING";
            }
          }

          let opacity = isActive ? 1 : Math.max(0.2, 0.55 - dist * 0.28);
          let scale = isActive ? 1 : Math.max(0.92, 1 - dist * 0.04);

          if (isLastBlock && isExiting) {
            const syncedOpacity = Math.max(0.2, 0.55 - 0.28);
            const syncedScale = Math.max(0.92, 1 - 0.04);
            const clearProgress = Math.min(1, exitProgress * 1.15);
            opacity = syncedOpacity * (1 - clearProgress);
            scale = syncedScale - (syncedScale - 0.92) * clearProgress;
          }

          gsap.set(block, { opacity, scale, pointerEvents: isActive ? "auto" : "none" });
        });

        gsap.set(stage, { opacity: uiOpacity });

        if (sectionBackdrop) {
          gsap.set(sectionBackdrop, { opacity: uiOpacity });
        }
        if (sectionOverlay) {
          gsap.set(sectionOverlay, { opacity: uiOpacity });
        }
      };

      updateLayout();
      requestAnimationFrame(() => {
        updateLayout();
        updateScrollState(0);
      });

      this.resizeObserver = new ResizeObserver(() => {
        updateLayout();
        ScrollTrigger.refresh();
        if (exitTrigger?.isActive) {
          const contentRatio = getContentRatio();
          updateScrollState(
            1,
            contentRatio + exitTrigger.progress * (1 - contentRatio)
          );
        } else if (chainTrigger) {
          const contentRatio = getContentRatio();
          updateScrollState(
            chainTrigger.progress,
            chainTrigger.progress * contentRatio
          );
        }
      });
      this.resizeObserver.observe(stageBody);

      const contentScrollDistance = () =>
        (blockCount - 1) * SCROLL_PER_BLOCK * window.innerHeight;
      const exitScrollDistance = () => END_DWELL * window.innerHeight;

      chainTrigger = ScrollTrigger.create({
        trigger: pinTrack,
        start: "top top",
        end: () => `+=${contentScrollDistance()}`,
        pin: stage,
        scrub: true,
        anticipatePin: 0,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          const contentRatio = getContentRatio();
          updateScrollState(self.progress, self.progress * contentRatio);
        },
      });
      this.scrollTriggers.push(chainTrigger);

      exitTrigger = ScrollTrigger.create({
        trigger: exitTrack,
        start: "top top",
        end: () => `+=${exitScrollDistance()}`,
        scrub: true,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          const contentRatio = getContentRatio();
          updateScrollState(1, contentRatio + self.progress * (1 - contentRatio));
        },
      });
      this.scrollTriggers.push(exitTrigger);

      updateScrollState(0);
    }
  }

  customElements.define("unique-features-chain", UniqueFeaturesChain);
</script>

<style>
  .unique-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-block: clamp(-2.5rem, -5vw, -4rem);
    padding-block: clamp(2rem, 4vw, 3.25rem) 0;
  }

  .unique-section.section {
    padding-block: clamp(2rem, 4vw, 3.25rem) 0;
  }

  .unique-section__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url("/images/parallax/WarthogParallaxBGcolor640.jpg");
    background-size: cover;
    background-position: 50% 10%;
    background-repeat: no-repeat;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 12%, #000 88%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 12%, #000 88%, transparent 100%);
  }

  @media (min-width: 768px) {
    .unique-section__backdrop {
      background-image: url("/images/parallax/WarthogParallaxBGcolor768.jpg");
      background-position: 50% 15%;
    }
  }

  @media (min-width: 1024px) {
    .unique-section__backdrop {
      background-image: url("/images/parallax/WarthogParallaxBGcolor.jpg");
      background-position: 50% 20%;
    }
  }

  .unique-section__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to bottom, var(--color-bg) 0%, transparent 16%),
      linear-gradient(to top, var(--color-bg) 0%, transparent 18%),
      linear-gradient(180deg, rgba(5, 9, 20, 0.15), rgba(2, 4, 10, 0.45)),
      linear-gradient(145deg, rgba(15, 17, 34, 0.25), rgba(3, 6, 17, 0.4));
    pointer-events: none;
  }

  .unique-section__content {
    position: relative;
    z-index: 2;
  }

  .features-intro {
    text-align: center;
    margin: 0 auto clamp(1.25rem, 2.5vw, 2rem);
    max-width: 800px;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    flex-shrink: 0;
  }

  .features-intro h2 {
    margin: 0.35rem 0 0.5rem;
  }

  /* ── Chain scroll pin ── */
  .chain-scroll-pin {
    --block-count: 7;
    --scroll-per-block: 88svh;
    --end-dwell: 93svh;
    position: relative;
  }

  .chain-pin-track {
    height: calc((var(--block-count) - 1) * var(--scroll-per-block));
  }

  .chain-exit-track {
    height: var(--end-dwell);
  }

  .chain-stage {
    position: relative;
    height: 100svh;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 1180px;
    margin-inline: auto;
    padding: clamp(0.5rem, 1.5vw, 1rem);
  }

  .chain-stage__body {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(0.5rem, 1.5vw, 1rem);
  }

  .chain-rail {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    height: min(72vh, 520px);
    width: 2rem;
    flex-shrink: 0;
  }

  .chain-rail__track {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 50%;
    width: 2px;
    translate: -50% 0;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    overflow: hidden;
  }

  .chain-rail__fill {
    width: 100%;
    height: 0%;
    background: linear-gradient(to bottom, var(--color-brand), var(--color-accent));
    border-radius: inherit;
    transition: height 0.15s ease;
  }

  .chain-rail__nodes {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    width: 100%;
  }

  .chain-rail__node {
    width: 0.65rem;
    height: 0.65rem;
    margin-inline: auto;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    border: 2px solid rgba(255, 255, 255, 0.15);
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, scale 0.2s ease;
  }

  .chain-rail__node.is-lit {
    background: var(--color-brand);
    border-color: rgba(253, 185, 19, 0.5);
  }

  .chain-rail__node.is-active {
    scale: 1.35;
    box-shadow: 0 0 12px rgba(253, 185, 19, 0.65);
  }

  .chain-viewport {
    position: relative;
    overflow: hidden;
    justify-self: center;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 10%, #000 90%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 10%, #000 90%, transparent 100%);
  }

  .chain-track {
    display: flex;
    flex-direction: column;
    gap: 28px;
    will-change: transform;
  }

  .chain-block {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(0.5rem, 1vw, 0.75rem);
    padding: clamp(0.85rem, 1.6vw, 1.15rem);
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 3px solid rgba(255, 255, 255, 0.15);
    background: #0c1222;
    box-shadow: 0 20px 40px rgba(2, 6, 23, 0.45);
    transform-origin: center center;
  }

  .chain-block.is-active {
    border-left-color: var(--color-brand);
    box-shadow:
      0 28px 56px rgba(2, 6, 23, 0.55),
      0 0 0 1px rgba(253, 185, 19, 0.15);
  }

  .chain-block.is-synced {
    border-left-color: rgba(56, 189, 248, 0.45);
  }

  .chain-block__meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .chain-block__height {
    font-weight: 700;
    color: var(--color-brand);
    font-family: var(--font-mono);
  }

  .chain-block__hash {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: none;
  }

  .chain-block__status {
    margin-left: auto;
    padding: 0.15rem 0.5rem;
