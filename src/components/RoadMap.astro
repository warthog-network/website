---
import ContentDiv from "../components/ContentDiv.jsx";

/**
 * Priority orbit aligned with the draft roadmap.md (GitHub).
 * Quarters are approximate target windows from that document — not hard deadlines.
 * Source: https://github.com/warthog-network/docs/blob/master/_roadmap/roadmap.md
 */
const ROADMAP_MD =
  "https://github.com/warthog-network/docs/blob/master/_roadmap/roadmap.md";

const orbits = [
  {
    id: "core",
    label: "Core",
    quarter: "Q1 2025",
    status: "Active focus",
    title: "Where we are now",
    blurb:
      "Approximate target window from the draft roadmap. Highest-priority work still open in this band — dates can slip.",
    href: `${ROADMAP_MD}#q1-2025`,
    accent: "#facc15",
    items: [
      {
        text: "Demo of the custom Sandwich-Proof matching engine",
        done: true,
      },
      {
        text: "Scientific paper on Sandwich-Proof DeFi (Fair Batch Matching)",
        done: true,
      },
      { text: "List Warthog on CoinMarketCap", done: false },
      { text: "Usable UI for Browser Nodes", done: false },
    ],
  },
  {
    id: "near",
    label: "Near orbit",
    quarter: "Q2 2025",
    status: "Next up",
    title: "Pulling into range",
    blurb:
      "Estimated next quarter on the draft roadmap. Intended once core items clear — still an approximate window.",
    href: `${ROADMAP_MD}#q2-2025`,
    accent: "#38bdf8",
    /** r = radius in viewBox units (center 50,50); duration s; start deg */
    orbit: { r: 28, duration: 18, start: -20 },
    items: [
      { text: "Infrastructure for Browser Nodes", done: false },
      { text: "Documentation for Browser Nodes", done: false },
      { text: "Implement light-weight DeFi", done: false },
      { text: "Enable token support on testnet", done: false },
      { text: "Enable liquidity farming on testnet", done: false },
      { text: "Enable Sandwich-Proof DeFi on testnet", done: false },
    ],
  },
  {
    id: "mid",
    label: "Mid orbit",
    quarter: "Q3 2025",
    status: "Queued",
    title: "On the trajectory",
    blurb:
      "Estimated mid-range window. Scope may flex as nearer orbits land.",
    href: `${ROADMAP_MD}#q3-2025`,
    accent: "#34d399",
    orbit: { r: 37, duration: 28, start: 120 },
    items: [
      {
        text: "P2P Browser Node communication (WebRTC)",
        done: false,
      },
      { text: "Add token support on mainnet", done: false },
      {
        text: "“Copy Balance” for newly created tokens (testnet)",
        done: false,
      },
    ],
  },
  {
    id: "horizon",
    label: "Horizon",
    quarter: "Q4 2025 – 2026",
    status: "Longer range",
    title: "Long-range direction",
    blurb:
      "Later draft-roadmap targets: late 2025 token features and 2026 research. Exploratory — not a ship commitment.",
    href: `${ROADMAP_MD}#q4-2025`,
    accent: "#c084fc",
    orbit: { r: 45, duration: 40, start: 210 },
    items: [
      {
        text: "Dividend payout feature for tokens (~Q4 2025)",
        done: false,
      },
      {
        text: "Research atomic swaps and assess feasibility for Warthog (~2026)",
        done: false,
      },
    ],
  },
];

const planets = orbits.filter((o) => o.id !== "core");

/**
 * Shipped foundation milestones — arranged around (and past) the outer orbit.
 * angle: degrees from 12 o’clock, clockwise.
 * radius: % of half-field from center (outer SVG orbit ≈ 31%; dashed ring ≈ 44%).
 * Positions are computed as left/top % — transform % is relative to the node itself.
 */
function foundationPoint(angleDeg, radiusPct) {
  const rad = (angleDeg * Math.PI) / 180;
  return {
    left: 50 + radiusPct * Math.sin(rad),
    top: 50 - radiusPct * Math.cos(rad),
  };
}

const foundation = {
  title: "Foundation (shipped)",
  href: `${ROADMAP_MD}#q1-2024`,
  idle: {
    kicker: "Foundation · shipped",
    title: "Delivered milestones",
    text: "Select a point around the map to review completed roadmap items (Q1 2024 – Q1 2025).",
  },
  items: [
    {
      id: "pobw",
      short: "PoBW",
      title: "Proof-of-Balanced-Work (Janushash)",
      detail:
        "Q1 2024 — Developed the world’s first PoBW mining algorithm (Janushash), pairing CPU and GPU work for fairer hardware participation.",
      angle: -62,
      radius: 41,
      size: 1.25,
    },
    {
      id: "stratum",
      short: "Stratum",
      title: "Stratum pool protocol",
      detail:
        "Q1 2024 — Stratum pool support so mining pools can coordinate hashpower against Warthog nodes with standard pool software.",
      angle: -8,
      radius: 48,
      size: 1,
    },
    {
      id: "network",
      short: "Networking",
      title: "Multi-transport networking",
      detail:
        "Q2 2024 — Networking stack refactored to support multiple transports for more resilient peer connectivity.",
      angle: 95,
      radius: 47,
      size: 1.05,
    },
    {
      id: "defi",
      short: "FBM engine",
      title: "Sandwich-proof DeFi matching",
      detail:
        "Q2–Q3 2024 — Sandwich-Proof DeFi research and C++ matching-engine implementation (Fair Batch Matching path).",
      angle: 48,
      radius: 36,
      size: 1.2,
    },
    {
      id: "browser-node",
      short: "Browser node",
      title: "In-browser node research",
      detail:
        "Q3 2024 — Research on in-browser node support — uncommon in crypto and groundwork for lighter client access.",
      angle: 148,
      radius: 39,
      size: 1,
    },
    {
      id: "listings",
      short: "Listings",
      title: "Exchange listings & public site",
      detail:
        "Q1 & Q4 2024 — Listings including Exbitron, Xeggex, CoinEx, and Bit.com, plus the Astro website and blog support.",
      angle: 268,
      radius: 37,
      size: 1.05,
    },
    {
      id: "wallet",
      short: "Wallet",
      title: "Browser wallet extension",
      detail:
        "Q4 2024 — Published the Warthog browser wallet extension for key management and on-chain transfers.",
      angle: 205,
      radius: 46,
      size: 1.1,
    },
  ].map((item) => ({
    ...item,
    ...foundationPoint(item.angle, item.radius),
  })),
};
---

<style>
  .roadmap-blanket {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 6vw, 6rem);
    padding-inline: clamp(1rem, 4vw, 5rem);
    background: radial-gradient(circle at 50% 35%, #101c34 0%, #050810 68%);
    color: #f8fafc;
  }

  .roadmap-blanket::before,
  .roadmap-blanket::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: clamp(3rem, 8vw, 6rem);
    pointer-events: none;
    z-index: 0;
  }

  .roadmap-blanket::before {
    top: 0;
    background: linear-gradient(to bottom, var(--color-bg), transparent);
  }

  .roadmap-blanket::after {
    bottom: 0;
    background: linear-gradient(to top, var(--color-bg), transparent);
  }

  .roadmap-blanket > * {
    position: relative;
    z-index: 1;
  }

  .roadmap__shell {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .roadmap__heading.section__header {
    max-width: none;
  }

  .roadmap__title-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    width: 100%;
  }

  .roadmap__cta {
    font-family: "Montserrat", var(--font-sans);
    color: var(--color-brand);
    font-size: 0.95rem;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    transition: color 0.2s ease;
  }

  .roadmap__cta:hover,
  .roadmap__cta:focus-visible {
    color: #fde047;
  }

  .roadmap__note {
    margin: 0;
    max-width: 52ch;
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.9rem;
    color: rgba(226, 232, 240, 0.65);
    line-height: 1.5;
  }

  .orbit-layout {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
  }

  @media (min-width: 960px) {
    .orbit-layout {
      grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.2fr);
    }
  }

  /*
   * Stage: orbit map centered, foundation milestones ringed around it.
   * Hybrid map: SVG rings + dots (always true circles at any width).
   * Core sun = original CSS yellow ball with pulse / hover glow.
   */
  .orbit-stage {
    position: relative;
    width: min(480px, 100%);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .orbit-stage__field {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
  }

  /* Soft ambient wash — no circular guide (keeps foundation looking scattered) */
  .orbit-stage__field::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 50%,
      transparent 28%,
      rgba(99, 102, 241, 0.04) 42%,
      transparent 58%
    );
    pointer-events: none;
    z-index: 1;
  }

  .orbit-map {
    --sun: 4.6rem;
    position: absolute;
    inset: 16%;
    width: auto;
    height: auto;
    margin: 0;
    line-height: 0;
    z-index: 2;
  }

  .orbit-map__svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    overflow: visible;
  }

  .orbit-map__path {
    fill: none;
    stroke: rgba(148, 163, 184, 0.3);
    stroke-width: 0.35;
    transition: stroke 0.25s ease, stroke-width 0.25s ease, opacity 0.25s ease;
    opacity: 0.85;
  }

  .orbit-map__path.is-active {
    stroke: var(--accent, #38bdf8);
    stroke-width: 0.65;
    opacity: 1;
  }

  /* —— Original core sun (first solar-system version) —— */
  .orbit-map__sun {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 6;
    width: var(--sun);
    height: var(--sun);
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    background:
      radial-gradient(circle at 32% 28%, #fffceb 0%, #fff7ad 12%, #facc15 42%, #e79300 78%, #b45309 100%);
    box-shadow:
      0 0 20px rgba(250, 204, 21, 0.55),
      0 0 48px rgba(250, 204, 21, 0.28),
      0 0 80px rgba(234, 179, 8, 0.14),
      inset 0 -6px 14px rgba(180, 83, 9, 0.35),
      inset 0 4px 10px rgba(255, 255, 255, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
  }

  /* Outer pulse halo (original) */
  .orbit-map__sun::after {
    content: "";
    position: absolute;
    inset: -28%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(250, 204, 21, 0.45) 0%, rgba(250, 204, 21, 0.12) 45%, transparent 70%);
    z-index: -1;
    animation: sun-pulse 3.2s ease-in-out infinite;
    pointer-events: none;
  }

  /* Specular highlight */
  .orbit-map__sun::before {
    content: "";
    position: absolute;
    left: 18%;
    top: 14%;
    width: 38%;
    height: 30%;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.75), transparent 70%);
    pointer-events: none;
  }

  .orbit-map__sun:hover,
  .orbit-map__sun:focus-visible {
    outline: none;
    transform: translate(-50%, -50%) scale(1.07);
    box-shadow:
      0 0 28px rgba(250, 204, 21, 0.8),
      0 0 60px rgba(250, 204, 21, 0.42),
      0 0 90px rgba(234, 179, 8, 0.2),
      inset 0 -6px 14px rgba(180, 83, 9, 0.35),
      inset 0 4px 10px rgba(255, 255, 255, 0.4);
  }

  .orbit-map__sun.is-active {
    transform: translate(-50%, -50%) scale(1.12);
    filter: brightness(1.1);
    box-shadow:
      0 0 32px rgba(250, 204, 21, 0.95),
      0 0 70px rgba(250, 204, 21, 0.5),
      0 0 100px rgba(234, 179, 8, 0.22),
      0 0 0 3px rgba(250, 204, 21, 0.4),
      inset 0 -6px 14px rgba(180, 83, 9, 0.3),
      inset 0 4px 10px rgba(255, 255, 255, 0.45);
  }

  .orbit-map__sun-label {
    position: absolute;
    left: 50%;
    top: calc(50% + var(--sun) / 2 + 0.4rem);
    z-index: 7;
    transform: translateX(-50%);
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(250, 204, 21, 0.88);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9);
    pointer-events: none;
    line-height: 1.2;
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .orbit-map:has(.orbit-map__sun.is-active) .orbit-map__sun-label {
    color: #fde047;
    text-shadow: 0 0 12px rgba(250, 204, 21, 0.55), 0 1px 10px rgba(0, 0, 0, 0.9);
  }

  .orbit-map__spinner {
    transform-box: view-box;
    transform-origin: 50px 50px;
    animation: orbit-spin var(--duration, 20s) linear infinite;
    animation-delay: var(--delay, 0s);
  }

  .orbit-map__dot-hit {
    cursor: pointer;
  }

  .orbit-map__dot-hit:focus {
    outline: none;
  }

  .orbit-map__dot {
    stroke: rgba(255, 255, 255, 0.4);
    stroke-width: 0.35;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      stroke 0.2s ease,
      stroke-width 0.2s ease,
      transform 0.2s ease,
      filter 0.2s ease;
  }

  /* Hover / active highlight — uniform scale keeps circles circular */
  .orbit-map__planet.is-active .orbit-map__dot,
  .orbit-map__spinner:hover .orbit-map__dot {
    stroke: #fff;
    stroke-width: 0.7;
    transform: scale(1.55);
    filter: url(#orbit-dot-glow);
  }

  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes sun-pulse {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-map__spinner,
    .orbit-map__sun::after {
      animation: none;
    }
  }

  @media (max-width: 759px) {
    .orbit-stage {
      width: min(360px, 100%);
    }

    .orbit-map {
      --sun: 3.4rem;
      inset: 18%;
    }

    .orbit-map__sun-label {
      font-size: 0.62rem;
    }
  }

  @media (max-width: 400px) {
    .orbit-stage {
      width: min(300px, 100%);
    }

    .orbit-map {
      --sun: 2.9rem;
      inset: 19%;
    }
  }

  /* Priority cards */
  .orbit-cards {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .orbit-card {
    --accent: #facc15;
    border-radius: 1.1rem;
    padding: 1.15rem 1.25rem;
    background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.04),
        rgba(15, 23, 42, 0.55)
      ),
      rgba(8, 12, 24, 0.88);
    border: 1px solid rgba(226, 232, 240, 0.08);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.3);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
    scroll-margin-top: 5rem;
  }

  .orbit-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .orbit-card:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--accent), 0 16px 36px rgba(0, 0, 0, 0.3);
  }

  .orbit-card[data-orbit="core"] {
    --accent: #facc15;
  }

  .orbit-card[data-orbit="near"] {
    --accent: #38bdf8;
  }

  .orbit-card[data-orbit="mid"] {
    --accent: #34d399;
  }

  .orbit-card[data-orbit="horizon"] {
    --accent: #c084fc;
  }

  .orbit-card.is-dimmed {
    opacity: 0.55;
  }

  .orbit-card.is-spotlight {
    opacity: 1;
    border-color: color-mix(in srgb, var(--accent) 65%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent),
      0 18px 40px rgba(0, 0, 0, 0.35);
  }

  .orbit-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .orbit-card__ring {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(226, 232, 240, 0.8);
  }

  .orbit-card__ring::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }

  .orbit-card__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .orbit-card__status {
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    color: color-mix(in srgb, var(--accent) 90%, #fff);
  }

  .orbit-card__quarter {
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid rgba(226, 232, 240, 0.18);
    color: rgba(226, 232, 240, 0.78);
    background: rgba(15, 23, 42, 0.45);
  }

  .orbit-card__quarter em {
    font-style: normal;
    font-weight: 500;
    opacity: 0.7;
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  .orbit-card h3 {
    margin: 0;
    font-family: "Montserrat", var(--font-sans);
    font-size: 1.15rem;
    font-weight: 700;
    color: #f8fafc;
  }

  .orbit-card__blurb {
    margin: 0.35rem 0 0.65rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: rgba(226, 232, 240, 0.7);
  }

  .orbit-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .orbit-card li {
    display: flex;
    gap: 0.65rem;
    font-size: 0.9rem;
    line-height: 1.4;
    color: rgba(226, 232, 240, 0.72);
  }

  .orbit-card li::before {
    content: "";
    width: 0.95rem;
    height: 0.95rem;
    margin-top: 0.15rem;
    border-radius: 0.3rem;
    flex-shrink: 0;
    border: 1px solid rgba(226, 232, 240, 0.3);
    background: rgba(15, 23, 42, 0.5);
  }

  .orbit-card li[data-done="true"] {
    color: rgba(248, 250, 252, 0.95);
  }

  .orbit-card li[data-done="true"]::before {
    content: "✔";
    font-size: 0.65rem;
    font-weight: 700;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    border-color: transparent;
    background: linear-gradient(135deg, var(--accent), #a855f7);
  }

  /* —— Foundation milestones around the orbit map —— */
  .foundation-ring {
    position: absolute;
    inset: 0;
    z-index: 8;
    pointer-events: none;
  }

  .foundation-node {
    --size: 1;
    position: absolute;
    /* left/top set in % of field via --x / --y (true polar layout) */
    left: var(--x, 50%);
    top: var(--y, 50%);
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.28rem;
    width: max-content;
    max-width: 5.5rem;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
    pointer-events: auto;
    appearance: none;
    -webkit-appearance: none;
    transition: opacity 0.25s ease, transform 0.22s ease;
    z-index: 1;
  }

  .foundation-node.is-active,
  .foundation-node:hover,
  .foundation-node:focus-visible {
    z-index: 2;
  }

  .foundation-node:focus {
    outline: none;
  }

  .foundation-node__dot {
    position: relative;
    width: calc(0.55rem * var(--size));
    height: calc(0.55rem * var(--size));
    border-radius: 50%;
    background: #e0e7ff;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.35),
      0 0 10px rgba(167, 139, 250, 0.55),
      0 0 18px rgba(99, 102, 241, 0.28);
    transition:
      transform 0.22s ease,
      background 0.22s ease,
      box-shadow 0.22s ease;
  }

  .foundation-node__dot::before {
    content: "";
    position: absolute;
    inset: -160%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(167, 139, 250, 0.4) 0%,
      rgba(167, 139, 250, 0.12) 40%,
      transparent 70%
    );
    animation: foundation-pulse var(--twinkle, 3.4s) ease-in-out infinite;
    animation-delay: var(--twinkle-delay, 0s);
    pointer-events: none;
  }

  .foundation-node__label {
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(199, 210, 254, 0.78);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.85);
    line-height: 1.15;
    text-align: center;
    transition: color 0.2s ease;
  }

  .foundation-node:hover .foundation-node__dot,
  .foundation-node:focus-visible .foundation-node__dot,
  .foundation-node.is-active .foundation-node__dot {
    background: #fde68a;
    transform: scale(1.45);
    box-shadow:
      0 0 0 2px rgba(255, 255, 255, 0.55),
      0 0 14px rgba(250, 204, 21, 0.85),
      0 0 28px rgba(250, 204, 21, 0.4);
  }

  .foundation-node:hover .foundation-node__dot::before,
  .foundation-node:focus-visible .foundation-node__dot::before,
  .foundation-node.is-active .foundation-node__dot::before {
    animation: none;
    background: radial-gradient(
      circle,
      rgba(250, 204, 21, 0.55) 0%,
      rgba(250, 204, 21, 0.15) 45%,
      transparent 70%
    );
  }

  .foundation-node:hover .foundation-node__label,
  .foundation-node:focus-visible .foundation-node__label,
  .foundation-node.is-active .foundation-node__label {
    color: #fef3c7;
  }

  .foundation-node:focus-visible .foundation-node__dot {
    outline: 2px solid rgba(253, 224, 71, 0.7);
    outline-offset: 3px;
  }

  .orbit-stage__field.is-focusing .foundation-node:not(.is-active):not(:hover) {
    opacity: 0.38;
  }

  .foundation-detail {
    width: 100%;
    border-radius: 0.9rem;
    padding: 0.9rem 1rem;
    border: 1px solid rgba(129, 140, 248, 0.2);
    background:
      linear-gradient(145deg, rgba(99, 102, 241, 0.1), rgba(15, 23, 42, 0.55)),
      rgba(8, 12, 24, 0.8);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease;
  }

  .foundation-detail.is-lit {
    border-color: rgba(250, 204, 21, 0.35);
    box-shadow:
      0 0 0 1px rgba(250, 204, 21, 0.1),
      0 12px 28px rgba(0, 0, 0, 0.28);
    background:
      linear-gradient(145deg, rgba(250, 204, 21, 0.08), rgba(15, 23, 42, 0.6)),
      rgba(8, 12, 24, 0.85);
  }

  .foundation-detail__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 0.75rem;
    margin-bottom: 0.35rem;
  }

  .foundation-detail__kicker {
    margin: 0;
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(165, 180, 252, 0.8);
  }

  .foundation-detail.is-lit .foundation-detail__kicker {
    color: rgba(253, 224, 71, 0.92);
  }

  .foundation-detail__link {
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-brand);
    text-decoration: none;
  }

  .foundation-detail__link:hover,
  .foundation-detail__link:focus-visible {
    color: #fde047;
  }

  .foundation-detail__title {
    margin: 0;
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.98rem;
    font-weight: 700;
    color: #f8fafc;
    line-height: 1.3;
  }

  .foundation-detail__text {
    margin: 0.35rem 0 0;
    font-size: 0.86rem;
    line-height: 1.45;
    color: rgba(226, 232, 240, 0.78);
  }

  .foundation-sr-list {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes foundation-pulse {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(0.92);
    }
    50% {
      opacity: 1;
      transform: scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .foundation-node,
    .foundation-node__dot,
    .foundation-detail {
      transition: none;
    }

    .foundation-node__dot::before {
      animation: none;
    }
  }

  @media (max-width: 759px) {
    .foundation-node {
      max-width: 4.6rem;
    }

    .foundation-node__label {
      font-size: 0.55rem;
    }
  }

  @media (max-width: 400px) {
    .foundation-node__label {
      /* Keep dots interactive; hide crowded labels on very small screens */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
  }
</style>

<div class="roadmap-blanket" id="roadmap">
  <ContentDiv>
    <div class="roadmap__shell">
      <div class="roadmap__heading section__header">
        <p class="section__eyebrow">Product Direction</p>
        <div class="roadmap__title-row">
          <h2 class="section__title">Priority orbit</h2>
          <a
            class="roadmap__cta"
            href={ROADMAP_MD}
            target="_blank"
            rel="noreferrer"
          >
            Full roadmap on GitHub »
          </a>
        </div>
        <p class="section__lede">
          Orbits map to the draft project roadmap. Closer rings are nearer
          target windows; outer rings are later estimates. Quarters are
          approximate — not hard ship dates.
        </p>
        <p class="roadmap__note">
          Aligned with the draft roadmap on GitHub. Windows can slip as research
          lands or priorities change; open a card for that quarter’s checklist.
        </p>
      </div>

      <div class="orbit-layout">
        <div class="orbit-stage" data-foundation>
          <div
            class="orbit-stage__field"
            data-foundation-field
            role="group"
            aria-label="Priority map with shipped foundation milestones"
          >
            <div class="orbit-map" role="group" aria-label="Priority solar system">
              <svg
                class="orbit-map__svg"
                viewBox="0 0 100 100"
                preserveAspectRatio="xMidYMid meet"
              >
                <defs>
                  <filter
                    id="orbit-dot-glow"
                    x="-150%"
                    y="-150%"
                    width="400%"
                    height="400%"
                    color-interpolation-filters="sRGB"
                  >
                    <feGaussianBlur in="SourceGraphic" stdDeviation="1.4" result="b"></feGaussianBlur>
                    <feMerge>
                      <feMergeNode in="b"></feMergeNode>
                      <feMergeNode in="SourceGraphic"></feMergeNode>
                    </feMerge>
                  </filter>
                </defs>

                <!-- Ambient glow under the CSS sun -->
                <circle cx="50" cy="50" r="18" fill="rgba(250,204,21,0.08)"></circle>
                <circle cx="50" cy="50" r="12" fill="rgba(250,204,21,0.12)"></circle>

                {
                  planets.map((planet) => (
                    <circle
                      class="orbit-map__path"
                      data-orbit-path={planet.id}
                      cx="50"
                      cy="50"
                      r={planet.orbit.r}
                      style={`--accent: ${planet.accent}`}
                    ></circle>
                  ))
                }

                {
                  planets.map((planet) => {
                    const delay = (
                      -(planet.orbit.start / 360) *
                      planet.orbit.duration
                    ).toFixed(3);
                    const cy = 50 - planet.orbit.r;
                    return (
                      <g
                        class="orbit-map__planet"
                        data-orbit-planet={planet.id}
                      >
                        <g
                          class="orbit-map__spinner"
                          style={`--duration: ${planet.orbit.duration}s; --delay: ${delay}s`}
                        >
                          {/* Invisible larger hit target for easier hover/click */}
                          <circle
                            class="orbit-map__dot-hit"
                            data-orbit-target={planet.id}
                            cx="50"
                            cy={cy}
                            r="5"
                            fill="transparent"
                            role="button"
                            tabindex="0"
                            aria-label={`Show ${planet.label} priorities`}
                          ></circle>
                          <circle
                            class="orbit-map__dot"
                            cx="50"
                            cy={cy}
                            r="2.5"
                            fill={planet.accent}
                            pointer-events="none"
                          ></circle>
                        </g>
                      </g>
                    );
                  })
                }
              </svg>

              <!-- Original CSS core sun -->
              <button
                type="button"
                class="orbit-map__sun is-active"
                data-orbit-target="core"
                aria-label="Show core priorities"
                title="Core — active focus"
              />
              <span class="orbit-map__sun-label" aria-hidden="true">Core</span>
            </div>

            <div class="foundation-ring" aria-hidden="false">
              {
                foundation.items.map((item, i) => {
                  const twinkle = (2.8 + (i % 4) * 0.55).toFixed(2);
                  const twinkleDelay = (-0.45 * i).toFixed(2);
                  return (
                    <button
                      type="button"
                      class="foundation-node"
                      data-foundation-item={item.id}
                      style={`--x: ${item.left.toFixed(2)}%; --y: ${item.top.toFixed(2)}%; --size: ${item.size}; --twinkle: ${twinkle}s; --twinkle-delay: ${twinkleDelay}s`}
                      aria-label={`${item.title}. ${item.detail}`}
                      aria-pressed="false"
                      data-title={item.title}
                      data-detail={item.detail}
                      data-short={item.short}
                    >
                      <span class="foundation-node__dot" aria-hidden="true"></span>
                      <span class="foundation-node__label">{item.short}</span>
                    </button>
                  );
                })
              }
            </div>
          </div>

          <div
            class="foundation-detail"
            data-foundation-detail
            aria-live="polite"
          >
            <div class="foundation-detail__head">
              <p class="foundation-detail__kicker" data-foundation-kicker>
                {foundation.idle.kicker}
              </p>
              <a
                class="foundation-detail__link"
                href={foundation.href}
                target="_blank"
                rel="noreferrer"
              >
                Full history »
              </a>
            </div>
            <p class="foundation-detail__title" data-foundation-title>
              {foundation.idle.title}
            </p>
            <p class="foundation-detail__text" data-foundation-text>
              {foundation.idle.text}
            </p>
          </div>

          <ul class="foundation-sr-list">
            {
              foundation.items.map((item) => (
                <li>
                  <strong>{item.title}</strong> — {item.detail}
                </li>
              ))
            }
          </ul>
        </div>

        <section class="orbit-cards" aria-label="Warthog priority orbit">
          {
            orbits.map((orbit) => (
              <a
                class={`orbit-card${orbit.id === "core" ? " is-spotlight" : ""}`}
                data-orbit={orbit.id}
                id={`orbit-${orbit.id}`}
                href={orbit.href}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={`${orbit.label}: ${orbit.title} — ${orbit.quarter} approx. (${orbit.status})`}
              >
                <div class="orbit-card__meta">
                  <span class="orbit-card__ring">{orbit.label}</span>
                  <div class="orbit-card__badges">
                    <span class="orbit-card__quarter">
                      ~{orbit.quarter} <em>approx.</em>
                    </span>
                    <span class="orbit-card__status">{orbit.status}</span>
                  </div>
                </div>
                <h3>{orbit.title}</h3>
                <p class="orbit-card__blurb">{orbit.blurb}</p>
                <ul>
                  {orbit.items.map((item) => (
                    <li data-done={item.done}>{item.text}</li>
                  ))}
                </ul>
              </a>
            ))
          }
        </section>
      </div>
    </div>
  </ContentDiv>
</div>

<script>
  function initOrbitMap() {
    const root = document.getElementById("roadmap");
    if (!root) return;

    // Allow re-bind after Astro client navigations
    if (root.dataset.orbitBound === "1") return;
    root.dataset.orbitBound = "1";

    const cards = Array.from(root.querySelectorAll(".orbit-card"));
    const targets = Array.from(root.querySelectorAll("[data-orbit-target]"));
    const paths = Array.from(root.querySelectorAll("[data-orbit-path]"));
    const planets = Array.from(root.querySelectorAll(".orbit-map__planet"));
    const sun = root.querySelector(".orbit-map__sun");

    const setActive = (id) => {
      if (!id) return;

      cards.forEach((card) => {
        const match = card.getAttribute("data-orbit") === id;
        card.classList.toggle("is-spotlight", match);
        card.classList.toggle("is-dimmed", !match);
      });

      planets.forEach((el) => {
        el.classList.toggle(
          "is-active",
          el.getAttribute("data-orbit-planet") === id,
        );
      });

      paths.forEach((path) => {
        path.classList.toggle(
          "is-active",
          path.getAttribute("data-orbit-path") === id,
        );
      });

      sun?.classList.toggle("is-active", id === "core");
    };

    const activate = (id) => {
      if (!id) return;
      setActive(id);
      root.querySelector(`#orbit-${id}`)?.scrollIntoView({
        behavior: "smooth",
        block: "nearest",
      });
    };

    // Map controls: hover highlights, click scrolls card
    targets.forEach((el) => {
      el.addEventListener("mouseenter", () => {
        setActive(el.getAttribute("data-orbit-target"));
      });
      el.addEventListener("focus", () => {
        setActive(el.getAttribute("data-orbit-target"));
      });
      el.addEventListener("click", (e) => {
        e.preventDefault();
        activate(el.getAttribute("data-orbit-target"));
      });
      el.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          activate(el.getAttribute("data-orbit-target"));
        }
      });
    });

    // Cards: hover highlights matching sun/dot
    cards.forEach((card) => {
      const on = () => setActive(card.getAttribute("data-orbit"));
      card.addEventListener("mouseenter", on);
      card.addEventListener("focus", on);
    });

    initFoundationRing(root);
  }

  function initFoundationRing(root) {
    const stage = root.querySelector("[data-foundation]");
    if (!stage || stage.dataset.foundationBound === "1") return;
    stage.dataset.foundationBound = "1";

    const field = stage.querySelector("[data-foundation-field]");
    const nodes = Array.from(stage.querySelectorAll("[data-foundation-item]"));
    const detail = stage.querySelector("[data-foundation-detail]");
    const kicker = stage.querySelector("[data-foundation-kicker]");
    const titleEl = stage.querySelector("[data-foundation-title]");
    const textEl = stage.querySelector("[data-foundation-text]");

    const idleCopy = {
      kicker: kicker?.textContent?.trim() || "Foundation · shipped",
      title: titleEl?.textContent?.trim() || "Delivered milestones",
      text:
        textEl?.textContent?.trim() ||
        "Select a point around the map to review what is already live in production.",
    };

    const itemData = {};
    nodes.forEach((el) => {
      const id = el.getAttribute("data-foundation-item");
      itemData[id] = {
        title: el.getAttribute("data-title") || "",
        detail: el.getAttribute("data-detail") || "",
        short: el.getAttribute("data-short") || id,
      };
    });

    let pinnedId = null;
    let hoverId = null;

    const litId = () => hoverId || pinnedId;

    const paint = () => {
      const id = litId();
      field?.classList.toggle("is-focusing", Boolean(id));
      detail?.classList.toggle("is-lit", Boolean(id));

      nodes.forEach((el) => {
        const match = el.getAttribute("data-foundation-item") === id;
        el.classList.toggle("is-active", match);
        el.setAttribute(
          "aria-pressed",
          match && pinnedId === id ? "true" : "false",
        );
      });

      if (id && itemData[id]) {
        if (kicker) kicker.textContent = "Foundation · shipped";
        if (titleEl) titleEl.textContent = itemData[id].title;
        if (textEl) textEl.textContent = itemData[id].detail;
      } else {
        if (kicker) kicker.textContent = idleCopy.kicker;
        if (titleEl) titleEl.textContent = idleCopy.title;
        if (textEl) textEl.textContent = idleCopy.text;
      }
    };

    nodes.forEach((el) => {
      const id = el.getAttribute("data-foundation-item");

      el.addEventListener("mouseenter", () => {
        hoverId = id;
        paint();
      });
      el.addEventListener("mouseleave", () => {
        if (hoverId === id) hoverId = null;
        paint();
      });
      el.addEventListener("focus", () => {
        hoverId = id;
        paint();
      });
      el.addEventListener("blur", () => {
        if (hoverId === id) hoverId = null;
        paint();
      });
      el.addEventListener("click", () => {
        pinnedId = pinnedId === id ? null : id;
        paint();
      });
    });

    paint();
  }

  initOrbitMap();
  document.addEventListener("astro:page-load", () => {
    const root = document.getElementById("roadmap");
    if (root) {
      root.dataset.orbitBound = "";
      const stage = root.querySelector("[data-foundation]");
      if (stage) stage.dataset.foundationBound = "";
    }
    initOrbitMap();
  });
</script>
