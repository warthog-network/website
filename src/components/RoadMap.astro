---
import ContentDiv from "../components/ContentDiv.jsx";

/**
 * Orbit-based priority map — no calendar deadlines.
 * Visual map is pure SVG so dots/sun stay true circles at every viewport size.
 */
const orbits = [
  {
    id: "core",
    label: "Core",
    status: "Active focus",
    title: "Where we are now",
    blurb:
      "Highest priority work in motion. This is our current position on the map — not a calendar promise.",
    href: "https://docs.warthog.network/roadmap/",
    accent: "#facc15",
    items: [
      { text: "Sandwich-Proof DeFi matching engine (demo & papers shipped)", done: true },
      { text: "Native DeFi path: tokens, liquidity, FBM on testnet", done: false },
      { text: "Browser-node experience polish (usable UI)", done: false },
      { text: "Exchange & market visibility (e.g. CMC listing)", done: false },
    ],
  },
  {
    id: "near",
    label: "Near orbit",
    status: "Next up",
    title: "Pulling into range",
    blurb:
      "Work we intend to tackle as core items clear. Priority-ordered, not dated.",
    href: "https://docs.warthog.network/roadmap/",
    accent: "#38bdf8",
    /** r = radius in viewBox units (center 50,50); duration s; start deg */
    orbit: { r: 28, duration: 18, start: -20 },
    items: [
      { text: "Browser Node infrastructure & docs", done: false },
      { text: "Lightweight DeFi surface for everyday use", done: false },
      { text: "Token support + liquidity farming on testnet", done: false },
      { text: "Sandwich-Proof DeFi fully enabled on testnet", done: false },
    ],
  },
  {
    id: "mid",
    label: "Mid orbit",
    status: "Queued",
    title: "On the trajectory",
    blurb:
      "Clear direction once nearer orbits settle. Scope may flex as the core hardens.",
    href: "https://docs.warthog.network/roadmap/",
    accent: "#34d399",
    orbit: { r: 37, duration: 28, start: 120 },
    items: [
      { text: "P2P Browser Node communication (WebRTC)", done: false },
      { text: "Token support on mainnet", done: false },
      { text: "Copy-balance feature for newly created tokens (testnet)", done: false },
      { text: "Dividend payout feature for tokens", done: false },
    ],
  },
  {
    id: "horizon",
    label: "Horizon",
    status: "Research",
    title: "Long-range direction",
    blurb:
      "Exploratory and feasibility work. Signals where curiosity points — not a ship commitment.",
    href: "https://docs.warthog.network/roadmap/#2026",
    accent: "#c084fc",
    orbit: { r: 45, duration: 40, start: 210 },
    items: [
      {
        text: "Atomic swaps — research feasibility for Warthog",
        done: false,
      },
    ],
  },
];

const planets = orbits.filter((o) => o.id !== "core");

const foundation = {
  title: "Foundation (shipped)",
  href: "https://docs.warthog.network/roadmap/",
  items: [
    "World’s first PoBW mining algorithm (Janushash)",
    "Stratum pool support",
    "Multi-transport networking refactor",
    "Sandwich-Proof DeFi research & matching engine code",
    "In-browser node research",
    "Major exchange listings & new Astro website",
    "Browser wallet extension",
  ],
};
---

<style>
  .roadmap-blanket {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 6vw, 6rem);
    padding-inline: clamp(1rem, 4vw, 5rem);
    background: radial-gradient(circle at 50% 35%, #101c34 0%, #050810 68%);
    color: #f8fafc;
  }

  .roadmap-blanket::before,
  .roadmap-blanket::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: clamp(3rem, 8vw, 6rem);
    pointer-events: none;
    z-index: 0;
  }

  .roadmap-blanket::before {
    top: 0;
    background: linear-gradient(to bottom, var(--color-bg), transparent);
  }

  .roadmap-blanket::after {
    bottom: 0;
    background: linear-gradient(to top, var(--color-bg), transparent);
  }

  .roadmap-blanket > * {
    position: relative;
    z-index: 1;
  }

  .roadmap__shell {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .roadmap__heading.section__header {
    max-width: none;
  }

  .roadmap__title-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    width: 100%;
  }

  .roadmap__cta {
    font-family: "Montserrat", var(--font-sans);
    color: var(--color-brand);
    font-size: 0.95rem;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    transition: color 0.2s ease;
  }

  .roadmap__cta:hover,
  .roadmap__cta:focus-visible {
    color: #fde047;
  }

  .roadmap__note {
    margin: 0;
    max-width: 52ch;
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.9rem;
    color: rgba(226, 232, 240, 0.65);
    line-height: 1.5;
  }

  .orbit-layout {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
  }

  @media (min-width: 960px) {
    .orbit-layout {
      grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.2fr);
    }
  }

  /*
   * Hybrid map: SVG rings + dots (always true circles at any width).
   * Core sun = original CSS yellow ball with pulse / hover glow.
   */
  .orbit-map {
    --sun: 5.25rem;
    position: relative;
    width: min(400px, 100%);
    margin-inline: auto;
    line-height: 0;
  }

  .orbit-map__svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    overflow: visible;
  }

  .orbit-map__path {
    fill: none;
    stroke: rgba(148, 163, 184, 0.3);
    stroke-width: 0.35;
    transition: stroke 0.25s ease, stroke-width 0.25s ease, opacity 0.25s ease;
    opacity: 0.85;
  }

  .orbit-map__path.is-active {
    stroke: var(--accent, #38bdf8);
    stroke-width: 0.65;
    opacity: 1;
  }

  /* —— Original core sun (first solar-system version) —— */
  .orbit-map__sun {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 6;
    width: var(--sun);
    height: var(--sun);
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    background:
      radial-gradient(circle at 32% 28%, #fffceb 0%, #fff7ad 12%, #facc15 42%, #e79300 78%, #b45309 100%);
    box-shadow:
      0 0 20px rgba(250, 204, 21, 0.55),
      0 0 48px rgba(250, 204, 21, 0.28),
      0 0 80px rgba(234, 179, 8, 0.14),
      inset 0 -6px 14px rgba(180, 83, 9, 0.35),
      inset 0 4px 10px rgba(255, 255, 255, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
  }

  /* Outer pulse halo (original) */
  .orbit-map__sun::after {
    content: "";
    position: absolute;
    inset: -28%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(250, 204, 21, 0.45) 0%, rgba(250, 204, 21, 0.12) 45%, transparent 70%);
    z-index: -1;
    animation: sun-pulse 3.2s ease-in-out infinite;
    pointer-events: none;
  }

  /* Specular highlight */
  .orbit-map__sun::before {
    content: "";
    position: absolute;
    left: 18%;
    top: 14%;
    width: 38%;
    height: 30%;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.75), transparent 70%);
    pointer-events: none;
  }

  .orbit-map__sun:hover,
  .orbit-map__sun:focus-visible {
    outline: none;
    transform: translate(-50%, -50%) scale(1.07);
    box-shadow:
      0 0 28px rgba(250, 204, 21, 0.8),
      0 0 60px rgba(250, 204, 21, 0.42),
      0 0 90px rgba(234, 179, 8, 0.2),
      inset 0 -6px 14px rgba(180, 83, 9, 0.35),
      inset 0 4px 10px rgba(255, 255, 255, 0.4);
  }

  .orbit-map__sun.is-active {
    transform: translate(-50%, -50%) scale(1.12);
    filter: brightness(1.1);
    box-shadow:
      0 0 32px rgba(250, 204, 21, 0.95),
      0 0 70px rgba(250, 204, 21, 0.5),
      0 0 100px rgba(234, 179, 8, 0.22),
      0 0 0 3px rgba(250, 204, 21, 0.4),
      inset 0 -6px 14px rgba(180, 83, 9, 0.3),
      inset 0 4px 10px rgba(255, 255, 255, 0.45);
  }

  .orbit-map__sun-label {
    position: absolute;
    left: 50%;
    top: calc(50% + var(--sun) / 2 + 0.4rem);
    z-index: 7;
    transform: translateX(-50%);
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(250, 204, 21, 0.88);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9);
    pointer-events: none;
    line-height: 1.2;
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .orbit-map:has(.orbit-map__sun.is-active) .orbit-map__sun-label {
    color: #fde047;
    text-shadow: 0 0 12px rgba(250, 204, 21, 0.55), 0 1px 10px rgba(0, 0, 0, 0.9);
  }

  .orbit-map__spinner {
    transform-box: view-box;
    transform-origin: 50px 50px;
    animation: orbit-spin var(--duration, 20s) linear infinite;
    animation-delay: var(--delay, 0s);
  }

  .orbit-map__dot-hit {
    cursor: pointer;
  }

  .orbit-map__dot-hit:focus {
    outline: none;
  }

  .orbit-map__dot {
    stroke: rgba(255, 255, 255, 0.4);
    stroke-width: 0.35;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      stroke 0.2s ease,
      stroke-width 0.2s ease,
      transform 0.2s ease,
      filter 0.2s ease;
  }

  /* Hover / active highlight — uniform scale keeps circles circular */
  .orbit-map__planet.is-active .orbit-map__dot,
  .orbit-map__spinner:hover .orbit-map__dot {
    stroke: #fff;
    stroke-width: 0.7;
    transform: scale(1.55);
    filter: url(#orbit-dot-glow);
  }

  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes sun-pulse {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-map__spinner,
    .orbit-map__sun::after {
      animation: none;
    }
  }

  @media (max-width: 759px) {
    .orbit-map {
      --sun: 3.6rem;
      width: min(260px, 78vw);
    }

    .orbit-map__sun-label {
      font-size: 0.62rem;
    }
  }

  @media (max-width: 400px) {
    .orbit-map {
      --sun: 3.1rem;
      width: min(220px, 82vw);
    }
  }

  /* Priority cards */
  .orbit-cards {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .orbit-card {
    --accent: #facc15;
    border-radius: 1.1rem;
    padding: 1.15rem 1.25rem;
    background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.04),
        rgba(15, 23, 42, 0.55)
      ),
      rgba(8, 12, 24, 0.88);
    border: 1px solid rgba(226, 232, 240, 0.08);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.3);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
    scroll-margin-top: 5rem;
  }

  .orbit-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .orbit-card:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--accent), 0 16px 36px rgba(0, 0, 0, 0.3);
  }

  .orbit-card[data-orbit="core"] {
    --accent: #facc15;
  }

  .orbit-card[data-orbit="near"] {
    --accent: #38bdf8;
  }

  .orbit-card[data-orbit="mid"] {
    --accent: #34d399;
  }

  .orbit-card[data-orbit="horizon"] {
    --accent: #c084fc;
  }

  .orbit-card.is-dimmed {
    opacity: 0.55;
  }

  .orbit-card.is-spotlight {
    opacity: 1;
    border-color: color-mix(in srgb, var(--accent) 65%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent),
      0 18px 40px rgba(0, 0, 0, 0.35);
  }

  .orbit-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .orbit-card__ring {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(226, 232, 240, 0.8);
  }

  .orbit-card__ring::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }

  .orbit-card__status {
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    color: color-mix(in srgb, var(--accent) 90%, #fff);
  }

  .orbit-card h3 {
    margin: 0;
    font-family: "Montserrat", var(--font-sans);
    font-size: 1.15rem;
    font-weight: 700;
    color: #f8fafc;
  }

  .orbit-card__blurb {
    margin: 0.35rem 0 0.65rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: rgba(226, 232, 240, 0.7);
  }

  .orbit-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .orbit-card li {
    display: flex;
    gap: 0.65rem;
    font-size: 0.9rem;
    line-height: 1.4;
    color: rgba(226, 232, 240, 0.72);
  }

  .orbit-card li::before {
    content: "";
    width: 0.95rem;
    height: 0.95rem;
    margin-top: 0.15rem;
    border-radius: 0.3rem;
    flex-shrink: 0;
    border: 1px solid rgba(226, 232, 240, 0.3);
    background: rgba(15, 23, 42, 0.5);
  }

  .orbit-card li[data-done="true"] {
    color: rgba(248, 250, 252, 0.95);
  }

  .orbit-card li[data-done="true"]::before {
    content: "✔";
    font-size: 0.65rem;
    font-weight: 700;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    border-color: transparent;
    background: linear-gradient(135deg, var(--accent), #a855f7);
  }

  .foundation {
    margin-top: 0.5rem;
    border-radius: 1.1rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid rgba(129, 140, 248, 0.2);
    background: rgba(15, 23, 42, 0.45);
  }

  .foundation__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .foundation__title {
    margin: 0;
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(199, 210, 254, 0.95);
  }

  .foundation__link {
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-brand);
    text-decoration: none;
  }

  .foundation__link:hover {
    color: #fde047;
  }

  .foundation__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .foundation__chip {
    font-family: "Montserrat", var(--font-sans);
    font-size: 0.78rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgba(129, 140, 248, 0.25);
    background: rgba(99, 102, 241, 0.1);
    color: rgba(226, 232, 240, 0.85);
  }
</style>

<div class="roadmap-blanket" id="roadmap">
  <ContentDiv>
    <div class="roadmap__shell">
      <div class="roadmap__heading section__header">
        <p class="section__eyebrow">Product Direction</p>
        <div class="roadmap__title-row">
          <h2 class="section__title">Priority orbit</h2>
          <a
            class="roadmap__cta"
            href="https://docs.warthog.network/roadmap/"
            target="_blank"
            rel="noreferrer"
          >
            Full history on docs »
          </a>
        </div>
        <p class="section__lede">
          We plan by priority, not by calendar. Closer orbits are what we’re
          focused on now; outer rings show direction of travel without locking
          dates we can’t honestly promise.
        </p>
        <p class="roadmap__note">
          Rings can shift as research lands or priorities change — the map shows
          intent and position, not a shipping schedule.
        </p>
      </div>

      <div class="orbit-layout">
        <div class="orbit-map" role="group" aria-label="Priority solar system">
          <svg
            class="orbit-map__svg"
            viewBox="0 0 100 100"
            preserveAspectRatio="xMidYMid meet"
          >
            <defs>
              <filter
                id="orbit-dot-glow"
                x="-150%"
                y="-150%"
                width="400%"
                height="400%"
                color-interpolation-filters="sRGB"
              >
                <feGaussianBlur in="SourceGraphic" stdDeviation="1.4" result="b"></feGaussianBlur>
                <feMerge>
                  <feMergeNode in="b"></feMergeNode>
                  <feMergeNode in="SourceGraphic"></feMergeNode>
                </feMerge>
              </filter>
            </defs>

            <!-- Ambient glow under the CSS sun -->
            <circle cx="50" cy="50" r="18" fill="rgba(250,204,21,0.08)"></circle>
            <circle cx="50" cy="50" r="12" fill="rgba(250,204,21,0.12)"></circle>

            {
              planets.map((planet) => (
                <circle
                  class="orbit-map__path"
                  data-orbit-path={planet.id}
                  cx="50"
                  cy="50"
                  r={planet.orbit.r}
                  style={`--accent: ${planet.accent}`}
                ></circle>
              ))
            }

            {
              planets.map((planet) => {
                const delay = (
                  -(planet.orbit.start / 360) *
                  planet.orbit.duration
                ).toFixed(3);
                const cy = 50 - planet.orbit.r;
                return (
                  <g
                    class="orbit-map__planet"
                    data-orbit-planet={planet.id}
                  >
                    <g
                      class="orbit-map__spinner"
                      style={`--duration: ${planet.orbit.duration}s; --delay: ${delay}s`}
                    >
                      {/* Invisible larger hit target for easier hover/click */}
                      <circle
                        class="orbit-map__dot-hit"
                        data-orbit-target={planet.id}
                        cx="50"
                        cy={cy}
                        r="5"
                        fill="transparent"
                        role="button"
                        tabindex="0"
                        aria-label={`Show ${planet.label} priorities`}
                      ></circle>
                      <circle
                        class="orbit-map__dot"
                        cx="50"
                        cy={cy}
                        r="2.5"
                        fill={planet.accent}
                        pointer-events="none"
                      ></circle>
                    </g>
                  </g>
                );
              })
            }
          </svg>

          <!-- Original CSS core sun -->
          <button
            type="button"
            class="orbit-map__sun is-active"
            data-orbit-target="core"
            aria-label="Show core priorities"
            title="Core — active focus"
          />
          <span class="orbit-map__sun-label" aria-hidden="true">Core</span>
        </div>

        <section class="orbit-cards" aria-label="Warthog priority orbit">
          {
            orbits.map((orbit) => (
              <a
                class={`orbit-card${orbit.id === "core" ? " is-spotlight" : ""}`}
                data-orbit={orbit.id}
                id={`orbit-${orbit.id}`}
                href={orbit.href}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={`${orbit.label}: ${orbit.title} (${orbit.status})`}
              >
                <div class="orbit-card__meta">
                  <span class="orbit-card__ring">{orbit.label}</span>
                  <span class="orbit-card__status">{orbit.status}</span>
                </div>
                <h3>{orbit.title}</h3>
                <p class="orbit-card__blurb">{orbit.blurb}</p>
                <ul>
                  {orbit.items.map((item) => (
                    <li data-done={item.done}>{item.text}</li>
                  ))}
                </ul>
              </a>
            ))
          }
        </section>
      </div>

      <aside class="foundation" aria-label="Shipped foundation">
        <div class="foundation__head">
          <h3 class="foundation__title">{foundation.title}</h3>
          <a
            class="foundation__link"
            href={foundation.href}
            target="_blank"
            rel="noreferrer"
          >
            See archived quarters »
          </a>
        </div>
        <div class="foundation__chips">
          {
            foundation.items.map((item) => (
              <span class="foundation__chip">{item}</span>
            ))
          }
        </div>
      </aside>
    </div>
  </ContentDiv>
</div>

<script>
  function initOrbitMap() {
    const root = document.getElementById("roadmap");
    if (!root) return;

    // Allow re-bind after Astro client navigations
    if (root.dataset.orbitBound === "1") return;
    root.dataset.orbitBound = "1";

    const cards = Array.from(root.querySelectorAll(".orbit-card"));
    const targets = Array.from(root.querySelectorAll("[data-orbit-target]"));
    const paths = Array.from(root.querySelectorAll("[data-orbit-path]"));
    const planets = Array.from(root.querySelectorAll(".orbit-map__planet"));
    const sun = root.querySelector(".orbit-map__sun");

    const setActive = (id) => {
      if (!id) return;

      cards.forEach((card) => {
        const match = card.getAttribute("data-orbit") === id;
        card.classList.toggle("is-spotlight", match);
        card.classList.toggle("is-dimmed", !match);
      });

      planets.forEach((el) => {
        el.classList.toggle(
          "is-active",
          el.getAttribute("data-orbit-planet") === id,
        );
      });

      paths.forEach((path) => {
        path.classList.toggle(
          "is-active",
          path.getAttribute("data-orbit-path") === id,
        );
      });

      sun?.classList.toggle("is-active", id === "core");
    };

    const activate = (id) => {
      if (!id) return;
      setActive(id);
      root.querySelector(`#orbit-${id}`)?.scrollIntoView({
        behavior: "smooth",
        block: "nearest",
      });
    };

    // Map controls: hover highlights, click scrolls card
    targets.forEach((el) => {
      el.addEventListener("mouseenter", () => {
        setActive(el.getAttribute("data-orbit-target"));
      });
      el.addEventListener("focus", () => {
        setActive(el.getAttribute("data-orbit-target"));
      });
      el.addEventListener("click", (e) => {
        e.preventDefault();
        activate(el.getAttribute("data-orbit-target"));
      });
      el.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          activate(el.getAttribute("data-orbit-target"));
        }
      });
    });

    // Cards: hover highlights matching sun/dot
    cards.forEach((card) => {
      const on = () => setActive(card.getAttribute("data-orbit"));
      card.addEventListener("mouseenter", on);
      card.addEventListener("focus", on);
    });
  }

  initOrbitMap();
  document.addEventListener("astro:page-load", () => {
    const root = document.getElementById("roadmap");
    if (root) root.dataset.orbitBound = "";
    initOrbitMap();
  });
</script>
