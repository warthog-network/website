---
import { Picture } from 'astro:assets';
import { generateArticalIdentity } from '../scripts/ArticleIdentityGenerator.js';
import { getCollection } from "astro:content";
import NEWS1 from '../BalkyImages/NewsPost.png';
import NEWS2 from '../BalkyImages/DevPost.png';
import NEWS3 from '../BalkyImages/BlogPost.png';
import Arrow from '../BalkyImages/Arrow 1.png';

const newsUpdates = await getCollection('news');

const sortedArticles = Object.values(newsUpdates).sort(
    (a, b) => {
        const dateA = new Date(a.data.date).getTime();
        const dateB = new Date(b.data.date).getTime();

        return dateB - dateA;
    }
);

const last3Articles = sortedArticles.slice(0,3);

const GetArticleImage = (category) => {
  switch (category) {
    case "Developer Diary":
      return NEWS2.src;
    case "News Update":
      return NEWS1.src;
    case "Blog Post":
      return NEWS3.src;
  }
};
---
<style>
  .news-section {
    padding: clamp(2rem, 4vw, 3rem) 0;
  }

  .news-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    padding-inline: clamp(1rem, 4vw, 2rem);
  }

  .news-grid {
    display: grid;
    gap: clamp(1rem, 3vw, 1.5rem);
    padding-inline: clamp(1rem, 4vw, 2rem);
  }

  @media (min-width: 768px) {
    .news-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }

  .article-card {
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: clamp(1rem, 2vw, 1.5rem);
    background: rgba(8, 12, 24, 0.8);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    box-shadow: var(--shadow-card);
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.6s ease forwards;
  }

  .article-card img {
    width: 100%;
    border-radius: var(--radius-md);
    object-fit: cover;
  }

  .article-card h3 {
    margin: 0;
    font-size: 1rem;
  }

  .article-card p {
      border-radius: var(--radius-sm);
    border: 0px solid rgba(255, 255, 255, 0.08);
     box-shadow: var(--shadow-card);
    margin: 0;
    color: var(--color-text-muted);
  }

  .see-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
  }

  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animation-delay-0 { animation-delay: 0s; }
  .animation-delay-1 { animation-delay: 0.1s; }
  .animation-delay-2 { animation-delay: 0.2s; }
</style>

<section class="news-section section--surface">
  <div class="news-header">
    <div>
      <p class="section__eyebrow">Articles</p>
      <h2 class="section__title">Latest from the blog & dev diary</h2>
    </div>
    <a class="see-all" href="/news">
      See all
      <img src={Arrow.src} alt="" width="20" height="20" loading="lazy" />
    </a>
  </div>

  <div class="news-grid">
    {
      last3Articles.map((news, index) => (
        <a
          class={`article-card animation-delay-${index}`}
          href={`/articles/${generateArticalIdentity(news.data.title, news.data.date, news.data.author)}`}
        >
          <img src={GetArticleImage(news.data.category)} alt="" loading="lazy" />
          <p class="pill">{news.data.category}</p>
          <h3>{news.data.title}</h3>
          <p class="muted">{new Date(news.data.date).toLocaleDateString()}</p>
        </a>
      ))
    }
  </div>
</section>