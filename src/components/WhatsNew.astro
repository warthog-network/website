---
import { generateArticalIdentity } from '../scripts/ArticleIdentityGenerator.js';
import { getCollection } from "astro:content";
import NEWS1 from '../BalkyImages/NewsPost.png';
import NEWS2 from '../BalkyImages/DevPost.png';
import NEWS3 from '../BalkyImages/BlogPost.png';
import Arrow from '../BalkyImages/Arrow 1.png';

const newsUpdates = await getCollection('news');

const sortedArticles = Object.values(newsUpdates).sort(
    (a, b) => {
        const dateA = new Date(a.data.date).getTime();
        const dateB = new Date(b.data.date).getTime();

        return dateB - dateA;
    }
);

const last3Articles = sortedArticles.slice(0,3);

const GetArticleImage = (category) => {
  switch (category) {
    case "Developer Diary":
      return NEWS2.src;
    case "News Update":
      return NEWS1.src;
    case "Blog Post":
      return NEWS3.src;
    default:
      return NEWS3.src;
  }
};
---
<style>
  .news-section {
    position: relative;
    isolation: isolate;
    margin-top: clamp(-4rem, -9vw, -6rem);
    padding: clamp(4rem, 8vw, 5.5rem) 0 clamp(2rem, 4vw, 3rem);
  }

  .news-section::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse 70% 50% at 50% 20%, rgba(88, 28, 135, 0.08), transparent 70%),
      linear-gradient(to bottom, transparent, rgba(5, 9, 20, 0.12) 45%, transparent);
    pointer-events: none;
  }

  .news-section::after {
    background: linear-gradient(
      to top,
      rgba(8, 6, 22, 0.75),
      transparent
    );
  }

  .news-section > * {
    position: relative;
    z-index: 1;
  }

  .news-container {
    width: min(90rem, 100%);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .news-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: flex-end;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .news-header .section__header {
    margin-bottom: 0;
  }

  .news-grid {
    display: grid;
    gap: clamp(1rem, 3vw, 1.5rem);
  }

  @media (min-width: 768px) {
    .news-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .article-card {
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background:
      linear-gradient(160deg, rgba(12, 18, 34, 0.52), rgba(6, 10, 22, 0.68));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 12px 28px rgba(2, 6, 23, 0.2);
    text-decoration: none;
    color: inherit;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeUp 0.6s ease forwards;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  @media (hover: hover) {
    .article-card:hover {
      transform: translateY(-4px);
      border-color: rgba(253, 185, 19, 0.22);
      box-shadow:
        0 18px 36px rgba(2, 6, 23, 0.32),
        0 0 0 1px rgba(253, 185, 19, 0.08);
    }

    .article-card:hover .article-card__media img {
      transform: scale(1.04);
    }

    .article-card:hover .article-card__title {
      color: var(--color-brand);
    }
  }

  .article-card__media {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: rgba(255, 255, 255, 0.03);
  }

  .article-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .article-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: clamp(0.85rem, 2vw, 1.15rem);
  }

  .article-card__category {
    align-self: flex-start;
    font-size: 0.72rem;
    padding: 0.25rem 0.65rem;
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .article-card__title {
    margin: 0;
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .article-card__date {
    margin: 0;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .see-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
  }

  @keyframes fadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animation-delay-0 { animation-delay: 0s; }
  .animation-delay-1 { animation-delay: 0.1s; }
  .animation-delay-2 { animation-delay: 0.2s; }

  @media (prefers-reduced-motion: reduce) {
    .article-card {
      animation: none;
      opacity: 1;
      transform: none;
    }

    @media (hover: hover) {
      .article-card:hover {
        transform: none;
      }

      .article-card:hover .article-card__media img {
        transform: none;
      }
    }
  }
</style>

<section class="news-section section--surface section-blend">
  <div class="news-container">
    <div class="news-header">
      <div class="section__header">
        <p class="section__eyebrow">Articles</p>
        <h2 class="section__title">Latest from the blog & dev diary</h2>
      </div>
      <a class="see-all" href="/news">
        See all
        <img src={Arrow.src} alt="" width="20" height="20" loading="lazy" />
      </a>
    </div>

    <div class="news-grid">
      {
        last3Articles.map((news, index) => (
          <a
            class={`article-card animation-delay-${index}`}
            href={`/articles/${generateArticalIdentity(news.data.title, news.data.date, news.data.author)}`}
          >
            <div class="article-card__media">
              <img src={GetArticleImage(news.data.category)} alt="" loading="lazy" />
            </div>
            <div class="article-card__body">
              <span class="article-card__category pill">{news.data.category}</span>
              <h3 class="article-card__title">{news.data.title}</h3>
              <p class="article-card__date">{new Date(news.data.date).toLocaleDateString()}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>