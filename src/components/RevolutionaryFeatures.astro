---
import Sync from "../BalkyImages/Rev.Featureimgs/SYNC.svg";
import Balance from "../BalkyImages/Rev.Featureimgs/BALANCE.svg";
import Browsers from "../BalkyImages/Rev.Featureimgs/BROWERS.svg";

const features = [
  {
    title: "Chain descriptor sync",
    description:
      "Light-weight sync that lets nodes understand each other’s forks, cutting bandwidth and CPU requirements for everyone.",
    icon: Sync.src,
  },
  {
    title: "Proof of Balanced Work",
    description:
      "The first PoBW algorithm where CPU matters again. It moves us closer to the “one machine, one vote” principle.",
    icon: Balance.src,
  },
  {
    title: "In-browser full nodes",
    description:
      "OPFS + SQLite enable persistent browser nodes. Close the tab and pick up where you left off—no chain wipe.",
    icon: Browsers.src,
  },
];
---

<style>
  .rev-section {
    background: linear-gradient(180deg, rgba(5, 9, 20, 0.6), rgba(2, 4, 10, 0.95));
    position: relative;
    padding: clamp(2rem, 5vw, 4rem) 0; /* Added: Vertical padding for section separation */
  }

  .rev-grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.75rem);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    .rev-grid {
      grid-template-columns: 1fr;
      gap: clamp(2rem, 4vw, 3rem);
    }

    .rev-intro {
      margin-bottom: 1.5rem;
    }
  }

  @media (min-width: 1025px) {
    .rev-grid {
      grid-template-columns: 0.75fr 1.25fr;
      align-items: start;
    }
  }

  .content-grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    width: 100%;
    max-width: 100%;
  }

  /* Add a mobile-specific gap increase if needed */
  @media (max-width: 767px) {
    .content-grid {
      gap: clamp(1.5rem, 3vw, 2rem); /* Slightly larger gap on mobile to prevent card crowding */
    }
  }

  .rev-intro h2 {
    margin: 0.35rem 0 1rem;
  }

  .rev-card {
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(8, 12, 24, 0.85);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    display: grid;
    gap: 0.75rem;
    box-shadow: var(--shadow-soft);
    min-height: 0;
    overflow: hidden;
  }

  .rev-card__title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.4;
    word-wrap: break-word;
  }

  .rev-card__desc {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.6;
    word-wrap: break-word;
  }

  .rev-card img {
    width: 3rem;
    height: auto;
    display: block;
  }
</style>

<section class="section rev-section">
  <div class="site-shell rev-grid">
    <div class="rev-intro">
      <p class="section__eyebrow">Tech</p>
      <h2 class="section__title">Revolutionary features</h2>
      <p class="section__lede">
        Browser-native nodes, smarter sync, and a consensus algorithm that values balanced work—
        Warthog is engineering the tools a modern decentralized network actually needs.
      </p>
    </div>

    <div class="content-grid">
      {
        features.map((feature) => (
          <article class="rev-card">
            <img src={feature.icon} alt="" loading="lazy" />
            <h3 class="rev-card__title">{feature.title}</h3>
            <p class="rev-card__desc">{feature.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>