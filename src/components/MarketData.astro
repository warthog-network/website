---
import warthogShape from "../BalkyImages/warthogShape.svg"
import ContentDiv from "../components/ContentDiv.jsx";
---
<script>

import { createChart } from 'lightweight-charts';

  class wartChart extends HTMLElement {
    constructor() {
      super();
      this.refreshInterval = 60000;
      this.timer = null;
      this.chart = null;
      this.candlestickSeries = null;
      this.areaSeries = null;
      this.candlesOn = false;
      this.cachedData = new Map();
      this.LoadCachedDataFromLocalStorage()
    }
    
    async connectedCallback() {
        const container = document.getElementById("realChart"); 

        const chartOptions = { 
          width: container.clientWidth,
          height: container.clientHeight,
          layout: { 
            textColor: 'white', 
            background: { type: 'solid', color: 'black' }
          },
          grid: {
            vertLines: {
              color: 'transparent'
            },
            horzLines: {
              color: 'transparent'
            }
          },
          timeScale: {
            timeVisible: true
          }
        };

        this.chart = createChart(container, chartOptions);
        this.areaSeries = this.chart.addAreaSeries({
            lastValueVisible: false, // hide the last value marker for this series
            crosshairMarkerVisible: false, // hide the crosshair marker for this series
            lineColor: 'rgba(253, 185, 19, 1)',
            topColor: 'rgba(253, 185, 19, 0.8)',
            bottomColor: 'rgba(253, 185, 19, 0.1)',
        });
        this.candlestickSeries = this.chart.addCandlestickSeries({ 
            upColor: '#26a69a', 
            downColor: '#ef5350', 
            borderVisible: false, 
            wickUpColor: '#26a69a', 
            wickDownColor: '#ef5350',
            visible: false 
          });
        
        
        const sixMoButton = document.getElementById('6moChart');
        await this.GetSixMonthChartData(sixMoButton);


        document.getElementById("toggleChart").addEventListener('click', () => this.ToggleCharts());
        document.getElementById("6moChart").addEventListener('click', (event) => this.GetSixMonthChartData(event.target));
        document.getElementById("1moChart").addEventListener('click', (event) => this.GetOneMonthChartData(event.target));
        document.getElementById("5dayChart").addEventListener('click', (event) => this.GetFiveDayChartData(event.target));
        document.getElementById("1dayChart").addEventListener('click', (event) => this.GetOneDayChartData(event.target));

        window.addEventListener('resize', () => {
            const rect = container.getBoundingClientRect();
            this.chart.resize(Math.max(0, rect.width), Math.max(0, rect.height));
        })
      }

      ToggleCharts() {
          if (this.candlesOn) {
            this.candlestickSeries.applyOptions({
              visible: false
            });
            this.areaSeries.applyOptions({
              lineColor: 'rgba(0, 128, 0, 1)',
              visible: true
            });
          }else{
            this.areaSeries.applyOptions({
              lineColor: 'transparent',
              visible: false
            });
            this.candlestickSeries.applyOptions({
              visible: true
            });
          }
          this.candlesOn = !this.candlesOn;
      }

      async fetchChartData(days) {
        let data;
        const keyName = this.CachedDataKey(days);
        //console.log(keyName);

        if (this.cachedData.has(keyName) && this.CachedDataNotOld(this.cachedData.get(keyName), days)) {
          data = this.cachedData.get(keyName);
          //console.log("It was cached");
        }else{
          const url = `https://api.coingecko.com/api/v3/coins/warthog/ohlc?vs_currency=usd&days=${days}`;
          try {
            const response = await fetch(url);
            if (!response.ok) {
              throw new Error('Network response was not ok');
            }
            data = await response.json();
            this.cachedData.set(keyName, data)
            this.SaveCachedDataToLocalStorage(this.cachedData);
            //console.log("Queried and saved to cache");
          } catch (error) {
            console.error('Error fetching market data:', error);
            data = [[1642427876, 10, 10.63, 9.49, 9.55], [1642514276, 9.55, 10.30, 9.42, 9.94], [1642600676, 9.94, 10.17, 9.92, 9.78], [1642687076, 9.78, 10.59, 9.18, 9.51], [1642773476, 9.51, 10.46, 9.10, 10.17], [1642859876, 10.17, 10.96, 10.16, 10.47], [1642946276, 10.47, 11.39, 10.40, 10.81], [1643032676, 10.81, 11.60, 10.30, 10.75], [1643119076, 10.75, 11.60, 10.49, 10.93], [1643205476, 10.93, 11.53, 10.76, 10.96]];
          }
        }
        
        const remappedData = data.map(([time, open, high, low, close]) => ({open, high, low, close, time: time / 1000}));
        const remappedAreaData = data.map(([time, open, high, low, close]) => ({
            time: time / 1000,
            value: (close + open) / 2,
        }));

        console.log(remappedData);
        console.log(remappedAreaData);

        this.candlestickSeries.setData(remappedData);
        this.areaSeries.setData(remappedAreaData);
        
        this.chart.timeScale().fitContent(); 
      }

      CachedDataKey(days) {
        return days.toString();
      }

      CachedDataNotOld(data, days) {
        const dateNow = Date.now();
        if (data.length > 0) {
          const lastUpdate = data[data.length - 1][0];
          const dateDiff = dateNow - lastUpdate; 
          if (dateDiff < (1000 * 60 * days)) { // Buffer based on days
            return true;
          }
        }
        return false;
      }

      SaveCachedDataToLocalStorage(dataMap) {
        const obj = Object.fromEntries(dataMap);
        const dataObj = {
          mapData: obj,
          timestamp: Date.now()
        };

        localStorage.setItem("WarthogCharts", JSON.stringify(dataObj));
      }

      LoadCachedDataFromLocalStorage() {
        const storedData = JSON.parse(localStorage.getItem("WarthogCharts"));

        if (storedData) {
          const currentTime = Date.now();
          const oneDayMs = 86400000;
          if ("timestamp" in storedData && "mapData" in storedData) {
            if (currentTime - storedData.timestamp < oneDayMs) {
              this.cachedData = new Map(Object.entries(storedData.mapData));
            }
          }
        }
      }

      async GetSixMonthChartData(button = null) {
        await this.fetchChartData(180);

        if (button) {
          this.ClearButtonHighlights();
          button.classList.add("chartSelected");
        }
      }

      async GetOneMonthChartData(button = null) {
        await this.fetchChartData(30);

        if (button) {
          this.ClearButtonHighlights();
          button.classList.add("chartSelected");
        }
      }

      async GetFiveDayChartData(button = null) {
        await this.fetchChartData(5);

        if (button) {
          this.ClearButtonHighlights();
          button.classList.add("chartSelected");
        }
      }

      async GetOneDayChartData(button = null) {
        await this.fetchChartData(1);

        if (button) {
          this.ClearButtonHighlights();
          button.classList.add("chartSelected");
        }
      }

      ClearButtonHighlights() {
        const buttons = document.querySelectorAll(".GetChartFunction");

        buttons.forEach((btn) => {
          btn.classList.remove("chartSelected");
        });
      }
    }

    customElements.define('wart-chart', wartChart);

    
</script>
<script>
  class MarketDataComponent extends HTMLElement {
    constructor() {
      super();
      this.refreshInterval = 60000;
      this.timer = null;
      this.estimatedHalvingPointsByMinedAmount = [];
    }

    connectedCallback() {
      this.fetchMarketData();
      this.startTimer();
    }

    disconnectedCallback() {
      clearInterval(this.timer);
    }

    async fetchMarketData() {
        const url = 'https://api.coingecko.com/api/v3/coins/warthog';
        try {
          const response = await fetch(url);
          if (!response.ok) {
            throw new Error('Network response was not ok');
          }
          const data = await response.json();
          const marketData = data.market_data;
          
          const circulatingSupply = marketData.circulating_supply;
          const maxSupply = marketData.max_supply || 18921600; // Fallback

          await this.BuildHalvingPointEstimates({primaryCirculation: circulatingSupply});
          this.DisplayMinedInfo({primaryCirculation: circulatingSupply});

          document.getElementById('symbol').textContent = 'WART/USDT';
          document.getElementById('price').textContent = '$' + marketData.current_price.usd.toFixed(8);
          document.getElementById('updated').textContent = new Date(marketData.last_updated).toLocaleTimeString();
          document.getElementById('marketCap').textContent = '$' + marketData.market_cap.usd.toLocaleString();

        } catch (error) {
          console.error('Error fetching market data:', error);
          document.getElementById('symbol').textContent = 'Error';
          document.getElementById('price').textContent = 'N/A';
          document.getElementById('updated').textContent = 'Error fetching data';
        }
      }

    startTimer() {
      let countdown = this.refreshInterval / 1000;
      this.timer = setInterval(() => {
        countdown--;
        document.getElementById('countdown').textContent = `${countdown} seconds`;
        if (countdown <= 0) {
          countdown = this.refreshInterval / 1000;
          this.fetchMarketData();
        }
      }, 1000);
    }

    DisplayMinedInfo(apiData) {
      const maxSupply = 18921600
      const circulatingSupply = parseInt(apiData.primaryCirculation);
      const percentage = ((circulatingSupply / maxSupply) * 100);

      const amountToMineForNextHalving = this.CalculateNextAmountRequiredToMineForHalving(this.estimatedHalvingPointsByMinedAmount, circulatingSupply);
      const nextHalvingPercentage = ((amountToMineForNextHalving / maxSupply) * 100);
      
      const progressBar = document.querySelector(".progress-bar");
      const totalSupply = document.querySelector(".totalSupply");
      const progressPercentage = document.querySelector(".progress-percentage");
      const progressCirculatingSupply = document.querySelector(".progress-circulatingSupply");
      const currentMarker = document.querySelector(".progress-marker--current");
      const halvingMarker = document.querySelector(".progress-marker--halving");
      const nextHalvingValue = document.querySelector(".next-halving-value");

      progressBar.style.width = `${percentage}%`;
      currentMarker.style.left = `${percentage}%`;
      halvingMarker.style.left = `${nextHalvingPercentage}%`;
      totalSupply.textContent = maxSupply.toLocaleString();
      progressPercentage.textContent = `${percentage.toFixed(2)}% mined`;
      progressCirculatingSupply.textContent = `${circulatingSupply.toLocaleString()} WART`;
      nextHalvingValue.textContent = `${amountToMineForNextHalving.toLocaleString()} WART`;
    }
    async BuildHalvingPointEstimates(apiData) {
      const blockHeightPerHalving = 3153600;
      const initialRewardInWart = 3;
      const maxSupply = 18921600
      const circulatingSupply = parseInt(apiData.primaryCirculation);
      let runningTotal = 0;

      //Build a list of amounts required to mine at each halving stage
      if (this.estimatedHalvingPointsByMinedAmount.length === 0) {
        const amountToMine = (blockHeightPerHalving * initialRewardInWart);
        runningTotal = amountToMine;
        this.estimatedHalvingPointsByMinedAmount.push({AmountMined: amountToMine, reward: initialRewardInWart, runningTotal: runningTotal });
      } 
      while (this.estimatedHalvingPointsByMinedAmount.length > 0 && this.estimatedHalvingPointsByMinedAmount[this.estimatedHalvingPointsByMinedAmount.length - 1].runningTotal <= circulatingSupply) {
          const lastReward = this.estimatedHalvingPointsByMinedAmount[this.estimatedHalvingPointsByMinedAmount.length - 1].reward;
          const thisReward = lastReward / 2;
          const amountToMine = (blockHeightPerHalving * thisReward);
          runningTotal = this.estimatedHalvingPointsByMinedAmount[this.estimatedHalvingPointsByMinedAmount.length - 1].runningTotal + amountToMine;

          this.estimatedHalvingPointsByMinedAmount.push({AmountMined: amountToMine, reward: thisReward, runningTotal: runningTotal });
        }

      console.log(this.estimatedHalvingPointsByMinedAmount);
    }

    CalculateNextAmountRequiredToMineForHalving(estimateList, currentMined) {
      let runningTotal = 0;

      for (let i = 0; i < estimateList.length; i++) {
        runningTotal += estimateList[i].AmountMined;

        if (runningTotal > currentMined) {
          break;
        }
      }

      return runningTotal;
    }
  }

  
  customElements.define('market-data', MarketDataComponent);

</script>


<style>
  .market-section {
    position: relative;
    isolation: isolate;
    background: transparent;
  }

  .market-section::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse 80% 40% at 50% 0%, rgba(88, 28, 135, 0.12), transparent 70%),
      linear-gradient(to bottom, transparent, rgba(5, 9, 20, 0.25) 40%, transparent);
    pointer-events: none;
  }

  .market-section::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: clamp(3rem, 8vw, 6rem);
    background: linear-gradient(to top, var(--color-bg), transparent);
    pointer-events: none;
    z-index: 0;
  }

  .market-section > * {
    position: relative;
    z-index: 1;
  }

  .market-grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 1024px) {
    .market-grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: stretch;
    }
  }

  .chart-card,
  .market-stack,
  .progress-card {
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(8, 12, 24, 0.85);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    max-width: 100%;
  }

  .chart-panel__actions {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 0.75rem;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .chart-panel__canvas {
    width: 100%;
    max-width: 100%;
    height: 320px;
    border-radius: var(--radius-md);
    background: #020617;
    overflow: hidden;
    position: relative;
  }

  .chart-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 1rem;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .chart-btn {
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.45rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    background: transparent;
    cursor: pointer;
  }

  .chartSelected {
    background: rgba(56, 189, 248, 0.2);
    border-color: rgba(56, 189, 248, 0.6);
  }

  .market-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .market-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .market-stat {
    margin: 0;
    color: var(--color-text-muted);
  }

  .market-stat__value {
    color: var(--color-text);
    font-size: 1.1rem;
  }

  .countdown-pill {
    display: inline-flex;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.08);
    font-size: 0.85rem;
  }

  .progress-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .progress-meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .progress-meta__block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .progress-percentage {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-brand);
  }

  .progress-circulatingSupply,
  .next-halving-value {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .progress-track {
    width: 100%;
    height: 20px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.12);
    position: relative;
    overflow: hidden;
  }

  .progress-bar {
    position: absolute;
    inset: 0;
    width: 0%;
    border-radius: inherit;
    background: linear-gradient(90deg, #facc15 0%, #f59e0b 60%, #f4bc38 100%);
    transition: width 0.4s ease;
  }

  .progress-marker {
    position: absolute;
    top: -14px;
    width: 2px;
    height: 48px;
    background: rgba(248, 250, 252, 0.65);
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .progress-marker span {
    position: absolute;
    top: -18px;
    background: rgba(0, 0, 0, 0.65);
    padding: 0.1rem 0.35rem;
    border-radius: 999px;
    font-size: 0.65rem;
  }
</style>

<market-data>
  <section class="market-section section">
    <ContentDiv>
      <div class="section__header">
        <p class="section__eyebrow">Live data</p>
        <h2 class="section__title">Market pulse & supply progress</h2>
      </div>

      <div class="market-grid">
        <article class="chart-card">
          <div class="chart-panel__actions">
            <button id="toggleChart" class="chart-btn">Candle / Line</button>
          </div>
          <wart-chart>
            <div id="realChart" class="chart-panel__canvas"></div>
            <div class="chart-controls">
              <button id="1dayChart" class="chart-btn GetChartFunction">1 Day</button>
              <button id="5dayChart" class="chart-btn GetChartFunction">5 Days</button>
              <button id="1moChart" class="chart-btn GetChartFunction">1 Month</button>
              <button id="6moChart" class="chart-btn GetChartFunction">6 Months</button>
            </div>
          </wart-chart>
        </article>

        <section class="market-stack">
          <article class="market-card">
            <div class="text-xl font-semibold" id="symbol">Loading...</div>
            <p class="market-stat">
              CoinGecko price:
              <span class="market-stat__value" id="price">Loading...</span>
            </p>
            <p class="market-stat">
              Market cap:
              <span class="market-stat__value" id="marketCap">Not yet updated</span>
            </p>
            <p class="market-stat">
              Last updated:
              <span class="market-stat__value" id="updated">Not yet updated</span>
            </p>
            <div class="countdown-pill">
              Next update in:&nbsp;<span id="countdown">...</span>
            </div>
          </article>

          <article class="progress-card">
            <div class="progress-meta">
              <div class="progress-meta__block">
                <p class="market-meta__stat">Mined supply</p>
                <span class="progress-percentage">0% mined</span>
                <span class="progress-circulatingSupply">0 WART</span>
              </div>
              <div class="progress-meta__block text-right text-green-400">
                <p class="market-meta__stat">Next halving</p>
                <span class="next-halving-value">--</span>
                <small class="muted">Total <span class="totalSupply font-semibold text-white"></span></small>
              </div>
            </div>
            <div class="progress-track">
              <div class="progress-bar"><img class="absolute right-1" src={warthogShape.src}/></div>
              <div class="progress-marker progress-marker--current">
                <span>Now</span>
              </div>
              <div class="progress-marker progress-marker--halving">
                <span>Halving</span>
              </div>
            </div>
          </article>
        </section>
      </div>
    </ContentDiv>
  </section>
</market-data>