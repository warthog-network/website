---
import Planet from "../BalkyImages/upcomingFeatureimgs/Icon.svg";
import Screen from "../BalkyImages/upcomingFeatureimgs/Icon (1).svg";
import Burger from "../BalkyImages/upcomingFeatureimgs/Icon (2).svg";
import ContentDiv from "../components/ContentDiv.jsx";

const milestones = [
  {
    title: "P2P browser nodes",
    description:
      "First cryptocurrency to port full nodes to the browser using OPFS + SQLite. When you close the tab, the chain stays.",
    icon: Planet.src,
  },
  {
    title: "Hard-coded DeFi",
    description:
      "We’re embedding proven DeFi logic directly inside nodes to reduce exploits, fees, and scammy tokenomics.",
    icon: Screen.src,
  },
  {
    title: "Anti-sandwich matching",
    description:
      "By controlling the matching engine, transaction ordering no longer leaks alpha to MEV bots, solving DeFi’s biggest attack.",
    icon: Burger.src,
  },
];
---

<style>
  .upcoming {
    background: linear-gradient(180deg, rgba(0, 5, 18, 0.95), rgba(7, 12, 30, 0.9));
  }

  .upcoming-grid {
    display: grid;
    gap: clamp(1rem, 3vw, 1.75rem);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .upcoming-card {
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: rgba(3, 6, 20, 0.85);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: 0 25px 40px rgba(0, 0, 0, 0.4);
  }

  .upcoming-card__icon {
    width: 3.5rem;
  }

  .upcoming-card h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .upcoming-card p {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>

<section class="section upcoming">
  <ContentDiv>
    <div class="section__header">
      <p class="section__eyebrow">Upcoming</p>
      <h2 class="section__title">Revolutionary features</h2>
      <p class="section__lede">
        Shipping next: browser-native P2P, DeFi primitives inside the node, and matching engines
        that make sandwich attacks irrelevant.
      </p>
    </div>

    <div class="upcoming-grid">
      {
        milestones.map((milestone) => (
          <article class="upcoming-card">
            <img class="upcoming-card__icon" src={milestone.icon} alt="" loading="lazy" />
            <h3>{milestone.title}</h3>
            <p>{milestone.description}</p>
          </article>
        ))
      }
    </div>
  </ContentDiv>
</section>
