---
import Wallet from "../BalkyImages/getstartedimgs/wallet.svg";
import Nodes from "../BalkyImages/getstartedimgs/blockchain_nodes.svg";
import GPU from "../BalkyImages/getstartedimgs/gpu.svg";
import Pool from "../BalkyImages/getstartedimgs/pool.svg";
import Pickaxe from "../BalkyImages/getstartedimgs/pickaxe.svg";
import Book from "../BalkyImages/getstartedimgs/book.svg";
import Ledger from "../BalkyImages/getstartedimgs/ledger.svg";

const webWalletUrl = "/webwallet";
/** Android APK ships via GitHub Releases (same pattern as warthog_extension). */
const MOBILE_WALLET_VERSION = "1.0.50";
const mobileWalletApk = `https://github.com/warthog-network/mobile-wallet/releases/download/v${MOBILE_WALLET_VERSION}/warthog-wallet-${MOBILE_WALLET_VERSION}.apk`;
const mobileWalletRelease = `https://github.com/warthog-network/mobile-wallet/releases/tag/v${MOBILE_WALLET_VERSION}`;

const EXTENSION_VERSION = "1.2.12";
const extensionZip = `https://github.com/warthog-network/extension-update/releases/download/${EXTENSION_VERSION}/warthog_extension.zip`;

/** In-browser full node (Netlify). */
const browserNodeUrl = "https://browser-node.netlify.app/";
/** Zip shipped from this repo: public/downloads/warthog_node_extension.zip */
const browserNodeExtensionZip = "/downloads/warthog_node_extension.zip";
/** GitHub always-latest release page for the Browser Node extension zip. */
const browserNodeExtensionReleases =
  "https://github.com/warthog-network/browser-node/releases/latest";

const wallets = [
  {
    title: "Wart DAPP (GUI)",
    description:
      "GUI wallet for Windows and Linux. Connects with one click to a public node, or manually type your node IP.",
    download: "https://github.com/warthog-network/wart-dapp/releases",
    guide: "https://docs.warthog.network/guides/wallet/wart-dapp/",
  },
  {
    title: "Wart-Wallet (GUI)",
    description:
      "GUI wallet for Windows and Linux. Manually type your node IP (local or public).",
    download: "https://github.com/warthog-network/wart-wallet/releases",
    guide: "https://github.com/warthog-network/wart-wallet/blob/master/README.md",
  },
  {
    title: "wart-wallet (command-line)",
    description:
      "Command-line wallet for power users. Manually type your node IP (local or public).",
    download: "https://github.com/warthog-network/Warthog/releases",
    guide: "https://docs.warthog.network/guides/wallet/cli/",
  },
  {
    title: "warthog_extension",
    description:
      `Browser extension v${EXTENSION_VERSION} for Chrome and Firefox (warthog_extension.zip). Mainnet + DeFi testnet, assets, DEX, and activity. Unzip → Load unpacked.`,
    download: extensionZip,
    guide: "https://docs.warthog.network/guides/wallet/browser-extension-wallet/",
  },
];
---

<style>
  .get-started-section {
    padding-block: clamp(3rem, 6vw, 5.5rem);
    scroll-margin-top: 5rem;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    background: rgba(8, 12, 24, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 0.35rem;
    gap: 0.35rem;
    margin-bottom: 2rem;
  }

  .tabs input[type="radio"] {
    display: none;
  }

  .tab-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1.25rem;
    cursor: pointer;
    border-radius: 8px;
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.2s, color 0.2s, box-shadow 0.2s;
    white-space: nowrap;
  }

  .tab-label:hover {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.04);
  }

  .tab-label img {
    width: 18px;
    height: 18px;
    opacity: 0.7;
    filter: brightness(1.4);
    transition: opacity 0.2s, filter 0.2s;
  }

  .tab-label:hover img {
    opacity: 1;
  }

  .tabs input:checked + .tab-label {
    background: var(--color-accent);
    color: #0f172a;
    box-shadow: 0 4px 14px rgba(56, 189, 248, 0.35);
  }

  .tabs input:checked + .tab-label img {
    opacity: 1;
    filter: brightness(0.3) saturate(1.5);
  }

  .tab-panel {
    display: none;
    flex-basis: 100%;
    margin-top: 1.5rem;
  }

  #tab-wallets:checked ~ #panel-wallets,
  #tab-node:checked ~ #panel-node,
  #tab-mining:checked ~ #panel-mining,
  #tab-hardware:checked ~ #panel-hardware {
    display: block;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .gs-card {
    background: rgba(8, 12, 24, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.5rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }

  .gs-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: var(--shadow-card);
  }

  .gs-card-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 30% 25%, rgba(253, 185, 19, 0.42), rgba(253, 185, 19, 0.12) 70%);
    border: 1px solid rgba(253, 185, 19, 0.72);
    border-radius: 0.85rem;
    box-shadow: 0 0 18px rgba(253, 185, 19, 0.22);
    margin-bottom: 0.25rem;
  }

  .gs-card-icon::before {
    content: "";
    width: 28px;
    height: 28px;
    background: #fdb913;
    mask: var(--gs-icon) center / contain no-repeat;
    -webkit-mask: var(--gs-icon) center / contain no-repeat;
    mask-mode: alpha;
    -webkit-mask-mode: alpha;
  }

  .gs-card h3 {
    font-size: 1.125rem;
    margin: 0;
    color: var(--color-text);
    font-weight: 600;
  }

  .gs-card p {
    color: var(--color-text-muted);
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .gs-card p a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .gs-card-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .gs-card-actions a {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    font-size: 0.85rem;
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  .gs-card-actions a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .gs-card-actions button {
    font: inherit;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    font-size: 0.85rem;
    color: var(--color-text);
    background: transparent;
    cursor: pointer;
  }

  .gs-card-actions button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .ledger-modal {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    background: rgba(2, 6, 16, 0.72);
  }

  .ledger-modal[hidden] {
    display: none;
  }

  .ledger-dialog {
    width: min(40rem, 100%);
    max-height: min(90vh, 52rem);
    overflow: auto;
    background: #0c1220;
    color: var(--color-text);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 1.25rem 1.3rem 1.5rem;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
  }

  .ledger-dialog h2 {
    margin: 0 0 0.75rem;
    font-size: 1.45rem;
  }

  .ledger-warn,
  .ledger-status,
  .ledger-step {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    margin: 0.75rem 0;
  }

  .ledger-warn {
    background: rgba(120, 86, 12, 0.28);
  }

  .ledger-status h3 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
  }

  .ledger-step h3 {
    margin: 0 0 0.3rem;
    font-size: 1rem;
  }

  .ledger-step > button {
    margin-top: 0.75rem;
  }

  .ledger-dialog p {
    margin: 0.35rem 0;
    line-height: 1.45;
  }

  .ledger-muted {
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .ledger-hash {
    font-family: ui-monospace, "Cascadia Code", monospace;
    font-size: 0.78rem;
    word-break: break-all;
  }

  .ledger-ok {
    color: #86efac;
    font-weight: 700;
  }

  .ledger-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .ledger-dialog button,
  .ledger-dialog a.ledger-link {
    font: inherit;
    font-weight: 650;
    border-radius: 10px;
    padding: 0.7rem 0.9rem;
    cursor: pointer;
    text-decoration: none;
  }

  .ledger-dialog button.primary {
    background: var(--color-accent);
    color: #0f172a;
    border: 0;
  }

  .ledger-dialog button.secondary,
  .ledger-dialog a.ledger-link {
    background: transparent;
    color: var(--color-text);
    border: 1px solid rgba(255, 255, 255, 0.16);
  }

  .ledger-dialog button.quiet {
    background: transparent;
    color: #f0b4b4;
    border: 1px solid rgba(240, 180, 180, 0.4);
  }

  .ledger-dialog button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .ledger-log {
    font-family: ui-monospace, "Cascadia Code", monospace;
    font-size: 0.78rem;
    white-space: pre-wrap;
    max-height: 9rem;
    overflow: auto;
    background: #070b14;
    border-radius: 10px;
    padding: 0.75rem;
    margin: 0.4rem 0 0;
  }

  .ledger-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
  }
</style>

<section class="get-started-section" id="get-started">
  <div class="site-shell">
    <div class="section__header">
      <p class="section__eyebrow">First Steps</p>
      <h1 class="section__title">Getting Started</h1>
      <p class="section__lede">
        Pick a wallet, run a node, start mining, or put Warthog on a Ledger.
      </p>
    </div>

    <div class="tabs">
      <input type="radio" name="tabs" id="tab-wallets" checked />
      <label for="tab-wallets" class="tab-label">
        <img src={Wallet.src} alt="" />
        <span>Wallets</span>
      </label>

      <input type="radio" name="tabs" id="tab-node" />
      <label for="tab-node" class="tab-label">
        <img src={Nodes.src} alt="" />
        <span>Node</span>
      </label>

      <input type="radio" name="tabs" id="tab-mining" />
      <label for="tab-mining" class="tab-label">
        <img src={GPU.src} alt="" />
        <span>Mining</span>
      </label>

      <input type="radio" name="tabs" id="tab-hardware" />
      <label for="tab-hardware" class="tab-label">
        <img src={Ledger.src} alt="" />
        <span>ledger-apps</span>
      </label>

      <div class="tab-panel" id="panel-wallets">
        <div class="cards-grid">
          {wallets.map((w) => (
            <div class="gs-card">
              <div class="gs-card-icon" style={`--gs-icon: url("${Wallet.src}")`}></div>
              <h3>{w.title}</h3>
              <p>{w.description}</p>
              <div class="gs-card-actions">
                <a href={w.download}>Download</a>
                <a href={w.guide}>Guide</a>
              </div>
            </div>
          ))}
          <div class="gs-card">
            <div class="gs-card-icon" style={`--gs-icon: url("${Wallet.src}")`}></div>
            <h3>Web Wallet</h3>
            <p>
              Browser-based wallet for desktop and mobile. Access your WART
              wallet from any device — no install required.
            </p>
            <div class="gs-card-actions">
              <a href={webWalletUrl}>Open Web Wallet</a>
            </div>
          </div>
          <div class="gs-card">
            <div class="gs-card-icon" style={`--gs-icon: url("${Wallet.src}")`}></div>
            <h3>Mobile Wallet</h3>
            <p>
              Android wallet app v{MOBILE_WALLET_VERSION}. Download the APK from
              GitHub Releases and install on your Android device.
            </p>
            <div class="gs-card-actions">
              <a href={mobileWalletApk}>Download APK v{MOBILE_WALLET_VERSION}</a>
              <a href={mobileWalletRelease}>Release notes</a>
            </div>
          </div>
        </div>
      </div>

      <div class="tab-panel" id="panel-node">
        <div class="cards-grid">
          <div class="gs-card">
            <div class="gs-card-icon" style={`--gs-icon: url("${Nodes.src}")`}></div>
            <h3>Run a Node</h3>
            <p>
              Install a node on your computer to support the blockchain
              decentralization, use your wallet with a local node, or mine
              solo.
            </p>
            <div class="gs-card-actions">
              <a href="https://github.com/warthog-network/Warthog/releases">Download</a>
              <a href="https://docs.warthog.network/guides/node/">Guide</a>
            </div>
          </div>
          <div class="gs-card">
            <div class="gs-card-icon" style={`--gs-icon: url("${Nodes.src}")`}></div>
            <h3>In-Browser Node</h3>
            <p>
              Run a full Warthog node directly in your browser — no install
              required. Open the page and connect to the network instantly.
            </p>
            <div class="gs-card-actions">
              <a
                href={browserNodeUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Open Browser Node
              </a>
            </div>
          </div>
          <div class="gs-card">
            <div class="gs-card-icon" style={`--gs-icon: url("${Nodes.src}")`}></div>
            <h3>Browser Node Extension</h3>
            <p>
              Same full WASM node as a Chrome / Brave / Edge extension. Side
              panel stays open while you browse. Download the zip, unzip, then
              Load unpacked in Developer mode.
            </p>
            <div class="gs-card-actions">
              <a
                href={browserNodeExtensionZip}
                target="_blank"
                rel="noopener noreferrer"
              >
                Download
              </a>
              <a
                href={browserNodeExtensionReleases}
                target="_blank"
                rel="noopener noreferrer"
              >
                Latest release
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="tab-panel" id="panel-mining">
        <div class="cards-grid">
          <div class="gs-card">
            <div class="gs-card-icon" style={`--gs-icon: url("${Book.src}")`}></div>
            <h3>Mining Guide</h3>
            <p>Start mining now. Janushash requires both CPU and GPU.</p>
            <div class="gs-card-actions">
              <a href="https://docs.warthog.network/guides/mining/quickstart/">English</a>
              <a href="https://docs.warthog.network/guides/mining/quickstart/quickstart_fr/">French</a>
            </div>
          </div>
          <div class="gs-card">
            <div class="gs-card-icon" style={`--gs-icon: url("${Pool.src}")`}></div>
            <h3>Mining Pools</h3>
            <p>List of mining pools for Warthog.</p>
            <div class="gs-card-actions">
              <a href="https://miningpoolstats.stream/warthog">Miningpoolstats</a>
              <a href="https://docs.warthog.network/links/#pools">Docs</a>
            </div>
          </div>
          <div class="gs-card">
            <div class="gs-card-icon" style={`--gs-icon: url("${Pickaxe.src}")`}></div>
            <h3>BzMiner</h3>
            <p>CPU/GPU Miner</p>
            <div class="gs-card-actions">
              <a href="https://www.bzminer.com/">Download</a>
            </div>
          </div>
        </div>
      </div>

      <div class="tab-panel" id="panel-hardware">
        <div class="cards-grid">
          <div class="gs-card">
            <div class="gs-card-icon" style={`--gs-icon: url("${Ledger.src}")`}></div>
            <h3>Ledger Nano S+</h3>
            <p>
              Install Warthog 0.3.0 on a Nano S+ with OS 1.7.0. The page
              checks the file hash, then loads that file over a USB cable.
              The app is the Rust build in
              <a href="https://github.com/warthog-network/ledger-warthog">ledger-warthog</a>.
              Use a test seed. This sideload is not in Ledger Wallet yet.
            </p>
            <div class="gs-card-actions">
              <button type="button" data-ledger="nanosplus">Install on Nano S+</button>
              <a href="https://github.com/warthog-network/ledger-warthog/releases/tag/v0.3.0">Release</a>
            </div>
          </div>
          <div class="gs-card">
            <div class="gs-card-icon" style={`--gs-icon: url("${Ledger.src}")`}></div>
            <h3>Ledger Stax</h3>
            <p>
              Install Warthog 0.3.0 on a Stax with OS 1.11.0. The page checks
              this Stax file, then loads it over a USB cable. Approve the
              prompt by tapping the screen. Use a test seed. This sideload is
              not in Ledger Wallet yet.
            </p>
            <div class="gs-card-actions">
              <button type="button" data-ledger="stax">Install on Stax</button>
              <a href="https://github.com/warthog-network/ledger-warthog/releases/tag/v0.3.0">Release</a>
            </div>
          </div>
          <div class="gs-card">
            <div class="gs-card-icon" style={`--gs-icon: url("${Ledger.src}")`}></div>
            <h3>Ledger Flex</h3>
            <p>
              Install Warthog 0.3.0 on a Flex with OS 1.7.0. The page checks
              this Flex file, then loads it over a USB cable. Approve the
              prompt by tapping the screen. Use a test seed. This sideload is
              not in Ledger Wallet yet.
            </p>
            <div class="gs-card-actions">
              <button type="button" data-ledger="flex">Install on Flex</button>
              <a href="https://github.com/warthog-network/ledger-warthog/releases/tag/v0.3.0">Release</a>
            </div>
          </div>
          <div class="gs-card">
            <div class="gs-card-icon" style={`--gs-icon: url("${Ledger.src}")`}></div>
            <h3>Ledger Apex P</h3>
            <p>
              Install Warthog 0.3.0 on an Apex P with OS 1.2.0. The page
              checks this Apex P file, then loads it over a USB cable. Approve
              the prompt by tapping the screen. Use a test seed. This sideload
              is not in Ledger Wallet yet.
            </p>
            <div class="gs-card-actions">
              <button type="button" data-ledger="apex_p">Install on Apex P</button>
              <a href="https://github.com/warthog-network/ledger-warthog/releases/tag/v0.3.0">Release</a>
            </div>
          </div>
          <div class="gs-card">
            <div class="gs-card-icon" style={`--gs-icon: url("${Ledger.src}")`}></div>
            <h3>Ledger Nano S</h3>
            <p>
              Install Warthog 0.2.0 on an original Nano S with OS 2.1.0. The
              0.3.0 Rust app has no Nano S build, so this page still serves
              the 0.2.0 file from the same
              <a href="https://github.com/warthog-network/ledger-warthog">ledger-warthog</a>
              repo. The eight review rows are paged with the two buttons on
              the 128×32 screen. Use a test seed. This sideload is not in
              Ledger Wallet yet.
            </p>
            <div class="gs-card-actions">
              <button type="button" data-ledger="nanos">Install on Nano S</button>
              <a href="https://github.com/warthog-network/ledger-warthog/releases/tag/v0.2.0">Release</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="ledger-modal" id="ledger-modal" hidden>
    <div class="ledger-dialog" role="dialog" aria-modal="true" aria-labelledby="ledger-title">
      <div class="ledger-top">
        <h2 id="ledger-title">Install Warthog on a Nano S+</h2>
        <button class="secondary" id="ledger-close" type="button">Close</button>
      </div>
      <div class="ledger-warn">
        <p>Use a Ledger with a test seed. Your seed and coins stay on the device. This page only puts the Warthog app on it, or takes that app off.</p>
        <p>File for this Ledger: <strong id="ledger-expected">0.3.0 for Nano S+, OS 1.7.0</strong></p>
        <p id="ledger-also">This file is Warthog 0.3.0 for Nano S+ OS 1.7.0 over a USB cable. It installs only on a Nano S+. The app source is the ledger-warthog repo.</p>
        <p class="ledger-muted">File SHA-256, checked before install:</p>
        <p class="ledger-hash" id="ledger-hash"></p>
        <p class="ledger-muted">Build digest recorded by the Ledger toolchain:</p>
        <p class="ledger-hash" id="ledger-build-hash"></p>
      </div>

      <section class="ledger-status" aria-live="polite">
        <h3 id="ledger-headline">Plug in your Nano S+.</h3>
        <p id="ledger-detail">Unlock it and stay on the home screen, the one with the app icons. Then click Check my Ledger.</p>
        <p class="ledger-ok" id="ledger-match" hidden>This matches the published app.</p>
      </section>

      <section class="ledger-step">
        <h3>1. Unlock the Ledger</h3>
        <p>Plug it in and enter your PIN. Stop on the home screen. Do not open an app yet. Chrome, Edge, Brave, and Opera can see the device. On Linux, Ledger's udev rules have to be installed, then unplug and plug the Ledger back in.</p>
        <div class="ledger-actions">
          <button class="secondary" id="ledger-check" type="button">Check my Ledger</button>
          <button class="secondary" id="ledger-download" type="button">Download the file</button>
          <a class="ledger-link" id="ledger-release" href="https://github.com/warthog-network/ledger-warthog/releases/tag/v0.3.0">Release</a>
        </div>
      </section>

      <section class="ledger-step">
        <h3>2. Install Warthog</h3>
        <p id="ledger-install-help">The button stays off until the Ledger is on the home screen. After you click it, watch the Ledger. On a Nano S+, press the right button until the screen says Allow unsafe manager, then press both buttons. Both buttons on Deny unsafe manager reject the install.</p>
        <button class="primary" id="ledger-install" type="button" disabled>Install Warthog 0.3.0</button>
      </section>

      <section class="ledger-step">
        <h3>3. Check that it worked</h3>
        <p id="ledger-version-help">On the Ledger, open the Warthog app. Then click the button. The status above should say Warthog 0.3.0.</p>
        <button class="secondary" id="ledger-version" type="button">Check the version</button>
      </section>

      <section class="ledger-step">
        <h3>4. Take Warthog off later</h3>
        <p>Go back to the home screen first. This removes the app. It leaves your PIN and seed on the Ledger.</p>
        <button class="quiet" id="ledger-remove" type="button" disabled>Remove Warthog</button>
      </section>

      <p class="ledger-muted">What the installer is doing:</p>
      <pre class="ledger-log" id="ledger-log">Nothing yet.</pre>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-ledger]").forEach((button) => {
    button.addEventListener("click", async () => {
      try {
        const { openLedgerModal } = await import("../lib/ledgerInstallUi.js");
        await openLedgerModal(button.dataset.ledger);
      } catch (err) {
        const modal = document.getElementById("ledger-modal");
        const headline = document.getElementById("ledger-headline");
        if (modal) modal.hidden = false;
        if (headline) headline.textContent = err && err.message ? err.message : "The installer did not open.";
      }
    });
  });
</script>
