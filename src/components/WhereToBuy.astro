---
import Safetrade from '../BalkyImages/wheretobuyimgs/safetrade.png'
import SafetradeShot from '../BalkyImages/wheretobuyimgs/safetrade-exchange.webp'

const icons = [
    {Visible: true, Name:"Safetrade exchange", ImgSrc: Safetrade.src, Shot: SafetradeShot, Url:"https://safetrade.com/exchange/WART-USDT?type=basic"},
];
---


<style>
  .buy-section {
    padding-block: clamp(3rem, 5vw, 4rem);
    scroll-margin-top: 5rem;
  }

  .buy-grid {
    display: grid;
    gap: clamp(1rem, 3vw, 1.5rem);
    grid-template-columns: minmax(0, 32rem);
    justify-content: center;
  }

  .exchange-card {
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(8, 12, 24, 0.75);
    padding: 0;
    overflow: hidden;
    text-align: center;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    box-shadow: var(--shadow-card);
  }

  .exchange-shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #131315;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .exchange-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .exchange-logo {
    max-height: 56px;
    width: auto;
    margin: 1rem auto;
    display: block;
  }
</style>

<section id="wheretobuy" class="buy-section site-shell">
  <div class="section__header">
    <p class="section__eyebrow">Exchanges</p>
    <h2 class="section__title">Where to buy WART</h2>
    <p class="section__lede">
      Trade WART/USDT on trusted platforms. Each listing is verified and actively monitored by the community.
    </p>
  </div>

  <div class="buy-grid">
    {
      icons
        .filter((icon) => icon.Visible)
        .map((icon) => (
          <a class="exchange-card" href={icon.Url} target="_blank" rel="noreferrer noopener">
            <div class="exchange-shot">
              <img
                src={icon.Shot.src}
                alt=""
                width={icon.Shot.width}
                height={icon.Shot.height}
                loading="lazy"
                decoding="async"
              />
            </div>
            <img class="exchange-logo" src={icon.ImgSrc} alt={icon.Name} loading="lazy" />
          </a>
        ))
    }
  </div>
</section>
