---
import Safetrade from '../BalkyImages/wheretobuyimgs/safetrade.png'

interface Props {
  /** Inside the homepage Ecosystem section: smaller heading, no extra shell padding. */
  embedded?: boolean;
}

const { embedded = false } = Astro.props;

const icons = [
    {Visible: true, Name:"Safetrade exchange", ImgSrc: Safetrade.src, Url:"https://safetrade.com/exchange/WART-USDT?type=basic"},
];
---


<style>
  .buy-section {
    padding-block: clamp(3rem, 5vw, 4rem);
    scroll-margin-top: 5rem;
  }

  .buy-grid {
    display: grid;
    gap: clamp(1rem, 3vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(180px, 280px));
    justify-content: center;
  }

  .exchange-card {
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(8, 12, 24, 0.75);
    padding: 1.5rem 1rem;
    text-align: center;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: var(--shadow-card);
  }

  .exchange-card img {
    max-height: 70px;
    margin-inline: auto;
  }

  .buy-section.is-embedded {
    padding-block: 0;
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: 0;
  }

  .buy-section.is-embedded .section__header {
    margin-bottom: 1.25rem;
  }

  .buy-section.is-embedded .section__title {
    font-size: clamp(1.25rem, 2.2vw, 1.65rem);
  }
</style>

<section id={embedded ? undefined : "wheretobuy"} class:list={["buy-section", "site-shell", { "is-embedded": embedded }]}>
  {!embedded && (
    <div class="section__header">
      <p class="section__eyebrow">Exchanges</p>
      <h2 class="section__title">Where to buy WART</h2>
      <p class="section__lede">
        Trade WART/USDT on trusted platforms. Each listing is verified and actively monitored by the community.
      </p>
    </div>
  )}

  <div class="buy-grid">
    {
      icons
        .filter((icon) => icon.Visible)
        .map((icon) => (
          <a class="exchange-card" href={icon.Url} target="_blank" rel="noreferrer noopener">
            <img src={icon.ImgSrc} alt={icon.Name} loading="lazy" />
          </a>
        ))
    }
  </div>
</section>
