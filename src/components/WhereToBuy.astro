---
import CoinEx from '../BalkyImages/wheretobuyimgs/coinex.svg';

import Bitcointry from '../BalkyImages/wheretobuyimgs/logo-full.webp'
import Safetrade from '../BalkyImages/wheretobuyimgs/safetrade.png'

const icons = [
    {Visible: true, Name:"CoinEx exchange", ImgSrc: CoinEx.src, Url:"https://www.coinex.com/en/exchange/WART-USDT"},
    {Visible: true, Name:"Bitcointry exchange", ImgSrc: Bitcointry.src, Url:"https://bitcointry.com/en/exchange/WART_USDT"},
    {Visible: true, Name:"Safetrade exchange", ImgSrc: Safetrade.src, Url:"https://safetrade.com/exchange/WART-USDT?type=basic"},
];
---


<style>
  .buy-section {
    padding-block: clamp(3rem, 5vw, 4rem);
  }

  .buy-grid {
    display: grid;
    gap: clamp(1rem, 3vw, 1.5rem);
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }

  .exchange-card {
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(8, 12, 24, 0.75);
    padding: 1.5rem 1rem;
    text-align: center;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: var(--shadow-card);
  }

  .exchange-card img {
    max-height: 70px;
    margin-inline: auto;
  }
</style>

<section id="wheretobuy" class="buy-section site-shell">
  <div class="section__header">
    <p class="section__eyebrow">Exchanges</p>
    <h2 class="section__title">Where to buy WART</h2>
    <p class="section__lede">
      Trade WART/USDT on trusted platforms. Each listing is verified and actively monitored by the community.
    </p>
  </div>

  <div class="buy-grid">
    {
      icons
        .filter((icon) => icon.Visible)
        .map((icon) => (
          <a class="exchange-card" href={icon.Url} target="_blank" rel="noreferrer noopener">
            <img src={icon.ImgSrc} alt={icon.Name} loading="lazy" />
          </a>
        ))
    }
  </div>
</section>
