---
import Pickaxe from "../BalkyImages/getstartedimgs/pickaxe.svg";
import Nodes from "../BalkyImages/getstartedimgs/blockchain_nodes.svg";
import Pool from "../BalkyImages/getstartedimgs/pool.svg";
import GPU from "../BalkyImages/getstartedimgs/gpu.svg";
import MinerShot from "../BalkyImages/ecosystem/miner-simulator.webp";
import WartNodeShot from "../BalkyImages/ecosystem/wartnode.webp";
import WartscanShot from "../BalkyImages/ecosystem/wartscan.webp";
import PoolShot from "../BalkyImages/ecosystem/warthog-pool.webp";
import EstimatorShot from "../BalkyImages/ecosystem/mining-estimator.webp";
import BzMinerShot from "../BalkyImages/ecosystem/bzminer.webp";
import CedricShot from "../BalkyImages/ecosystem/cedric-crispin.webp";
import WoolyShot from "../BalkyImages/ecosystem/woolypooly.webp";
import HeroShot from "../BalkyImages/ecosystem/herominers.webp";

/**
 * Independent community sites. Not operated by the core Warthog project.
 * `shot` files are static captures of each href.
 * Groups use their own radio name so they do not fight the Getting Started tabs.
 */
const groups = [
  {
    id: "explore",
    title: "Explore",
    icon: Nodes,
    projects: [
      {
        title: "WartNode",
        kind: "Beginner stats",
        description:
          "A simple stats page for people just getting started. It shows mainnet and DeFi testnet numbers, and links on to the explorers.",
        href: "https://wartnode.com/",
        host: "wartnode.com",
        icon: Nodes,
        shot: WartNodeShot,
      },
      {
        title: "Wartscan",
        kind: "Explorer",
        description:
          "Block explorer for the Warthog chain. Search an address or block height, and see the latest transactions, hashrate, supply, and price.",
        href: "https://wartscan.io/",
        host: "wartscan.io",
        icon: Nodes,
        shot: WartscanShot,
      },
    ],
  },
  {
    id: "mining",
    title: "Mining",
    icon: GPU,
    projects: [
      {
        title: "BzMiner",
        kind: "Miner",
        description:
          "CPU and GPU miner for Janushash. Point it at a pool, or at your own node to mine solo.",
        href: "https://www.bzminer.com/",
        host: "bzminer.com",
        icon: Pickaxe,
        shot: BzMinerShot,
      },
      {
        title: "Mining estimator",
        kind: "Hashrate board",
        description:
          "Community board of Janus results, clocks, and screenshots, with an estimated WART yield against the live network.",
        href: "https://warthog.txbitmining.com/",
        host: "warthog.txbitmining.com",
        icon: GPU,
        shot: EstimatorShot,
      },
      {
        title: "Miner simulator",
        kind: "Game",
        description:
          "A browser game about starting from an old PC and balancing CPU and GPU, inspired by Janushash. The cash and WART are fictional, and the numbers are not real mining results.",
        href: "https://athundera.github.io/wart-miner/en.html",
        host: "athundera.github.io",
        icon: Pickaxe,
        shot: MinerShot,
      },
    ],
  },
  {
    id: "pools",
    title: "Pools",
    icon: Pool,
    projects: [
      {
        title: "Warthog pool",
        kind: "TxBit Mining",
        description:
          "A community pool for Warthog. Point a miner at the stratum endpoint and payouts go to your WART address.",
        href: "https://pool.txbitmining.com/",
        host: "pool.txbitmining.com",
        icon: Pool,
        shot: PoolShot,
      },
      {
        title: "Warthog pool",
        kind: "Cédric Crispin",
        description:
          "Cédric Crispin's Warthog pool. Point a miner at the stratum server and payouts go to your WART address.",
        href: "https://warthog.cedric-crispin.com/",
        host: "warthog.cedric-crispin.com",
        icon: Pool,
        shot: CedricShot,
      },
      {
        title: "Warthog pool",
        kind: "WoolyPooly",
        description:
          "WoolyPooly's Warthog pool. Point a miner at the stratum endpoint and payouts go to your WART address.",
        href: "https://woolypooly.com/en/coin/wart",
        host: "woolypooly.com",
        icon: Pool,
        shot: WoolyShot,
      },
      {
        title: "Warthog pool",
        kind: "HeroMiners",
        description:
          "HeroMiners' Warthog pool, with pool and solo mining. Payouts go to your WART address.",
        href: "https://warthog.herominers.com/",
        host: "warthog.herominers.com",
        icon: Pool,
        shot: HeroShot,
      },
    ],
  },
];
---

<style>
  .ecosystem-section {
    padding-block: clamp(3rem, 6vw, 5.5rem);
    scroll-margin-top: 5rem;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    background: rgba(8, 12, 24, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 0.35rem;
    gap: 0.35rem;
    margin-bottom: 2rem;
  }

  .tabs input[type="radio"] {
    display: none;
  }

  .tab-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 1.25rem;
    cursor: pointer;
    border-radius: 8px;
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.2s, color 0.2s, box-shadow 0.2s;
    white-space: nowrap;
  }

  .tab-label:hover {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.04);
  }

  .tab-label img {
    width: 18px;
    height: 18px;
    opacity: 0.7;
    filter: brightness(1.4);
    transition: opacity 0.2s, filter 0.2s;
  }

  .tab-label:hover img {
    opacity: 1;
  }

  .tabs input:checked + .tab-label {
    background: var(--color-accent);
    color: #0f172a;
    box-shadow: 0 4px 14px rgba(56, 189, 248, 0.35);
  }

  .tabs input:checked + .tab-label img {
    opacity: 1;
    filter: brightness(0.3) saturate(1.5);
  }

  .tab-panel {
    display: none;
    flex-basis: 100%;
    margin-top: 1.5rem;
  }

  #eco-tab-explore:checked ~ #eco-panel-explore,
  #eco-tab-mining:checked ~ #eco-panel-mining,
  #eco-tab-pools:checked ~ #eco-panel-pools {
    display: block;
  }

  .eco-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  @media (min-width: 700px) {
    .eco-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .eco-grid {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }

  .eco-card {
    background: rgba(8, 12, 24, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem;
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    min-height: 100%;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }

  .eco-shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #070b16;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .eco-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.35s ease;
  }

  .eco-card:hover .eco-shot img,
  .eco-card:focus-visible .eco-shot img {
    transform: scale(1.035);
  }

  .eco-body {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1rem 1.15rem 1.15rem;
    flex: 1;
    min-width: 0;
  }

  .eco-kicker {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .eco-card:hover,
  .eco-card:focus-visible {
    transform: translateY(-2px);
    border-color: rgba(56, 189, 248, 0.45);
    box-shadow: var(--shadow-card);
    color: inherit;
  }

  .eco-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .eco-card-icon {
    width: 28px;
    height: 28px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 30% 25%, rgba(253, 185, 19, 0.42), rgba(253, 185, 19, 0.12) 70%);
    border: 1px solid rgba(253, 185, 19, 0.72);
    border-radius: 0.5rem;
    box-shadow: 0 0 18px rgba(253, 185, 19, 0.22);
  }

  .eco-card-icon img {
    width: 16px;
    height: 16px;
    display: block;
    filter: brightness(0) saturate(100%) invert(76%) sepia(61%) saturate(547%) hue-rotate(359deg) brightness(103%) contrast(101%);
  }

  .eco-kind {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .eco-card h3 {
    font-size: 1.125rem;
    margin: 0;
    color: var(--color-text);
    font-weight: 600;
  }

  .eco-card p {
    color: var(--color-text-muted);
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .eco-card-foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.75rem;
  }

  .eco-host {
    max-width: 100%;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    line-height: 1.35;
  }

  .eco-go {
    flex: none;
    color: var(--color-text);
    font-weight: 600;
  }

  .eco-card:hover .eco-go,
  .eco-card:focus-visible .eco-go {
    color: var(--color-accent);
  }

  .eco-note {
    margin: 1.25rem 0 0;
    max-width: 46rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .eco-card,
    .eco-shot img {
      transition: none;
    }

    .eco-card:hover,
    .eco-card:focus-visible,
    .eco-card:hover .eco-shot img,
    .eco-card:focus-visible .eco-shot img {
      transform: none;
    }
  }
</style>

<section class="ecosystem-section" id="ecosystem" aria-labelledby="ecosystem-title">
  <div class="site-shell">
    <div class="section__header">
      <p class="section__eyebrow">Community</p>
      <h2 class="section__title" id="ecosystem-title">Ecosystem</h2>
      <p class="section__lede">
        Community sites for the chain, mining, and pools.
      </p>
    </div>

    <div class="tabs">
      {groups.map((group, index) => (
        <>
          <input
            type="radio"
            name="eco-tabs"
            id={`eco-tab-${group.id}`}
            checked={index === 0}
          />
          <label for={`eco-tab-${group.id}`} class="tab-label">
            <img src={group.icon.src} alt="" />
            <span>{group.title}</span>
          </label>
        </>
      ))}
      {groups.map((group) => (
        <div class="tab-panel" id={`eco-panel-${group.id}`}>
          <div class="eco-grid">
            {group.projects.map((project) => (
              <a
                class="eco-card"
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <div class="eco-shot">
                  <img
                    src={project.shot.src}
                    alt=""
                    width={project.shot.width}
                    height={project.shot.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="eco-body">
                  <div class="eco-kicker">
                    <div class="eco-card-icon" aria-hidden="true">
                      <img src={project.icon.src} alt="" />
                    </div>
                    <p class="eco-kind">{project.kind}</p>
                  </div>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  <div class="eco-card-foot">
                    <span class="eco-host">{project.host}</span>
                    <span class="eco-go">Open</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="eco-note">
      These sites are run by their authors. They are separate from the wallets,
      node, and docs in Getting Started.
    </p>
  </div>
</section>
