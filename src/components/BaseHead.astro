---
import Astrobar from '../components/AstroBar.astro';

import DropDownMenu from '../components/Menu.astro';

---

<style is:global>
  .mobileMenu {
    position: fixed;
    /* Sit under the sticky main nav — logo stays; no duplicate banner. */
    top: 4.75rem;
    right: 0;
    transform: translateX(100%);
    height: calc(100dvh - 4.75rem);
    background: rgba(3, 6, 15, 0.95);
    backdrop-filter: blur(16px);
    transition: transform 0.3s ease-in-out;
    z-index: 15000;
    overflow-y: auto;
    overflow-x: hidden;
    box-sizing: border-box;
    padding: 1.25rem 1.5rem 2rem;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .mobileMenu.show {
    transform: translateX(0);
  }

  .mobileMenu .menu {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
    align-items: center;
    width: 100%;
  }

  .mobileMenu .menuItem {
    font-size: 1.1rem;
  }

  .mobileMenu .mobile-social-links {
    display: flex !important;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .mobileMenu .mobile-social-links a {
    display: inline-block;
  }

  .mobileMenu .ghost {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .mobileMenu .ghost .dropdown-content {
    position: relative;
    left: auto;
    transform: none;
    width: 100%;
    max-width: 100%;
    min-width: auto;
    box-sizing: border-box;
    margin-top: 0.5rem;
    overflow-x: hidden;
  }

  .mobileMenu .ghost .dropdown-content a,
  .mobileMenu .ghost .dropdown-content .node-entry {
    max-width: 100%;
    word-wrap: break-word;
    white-space: normal;
    box-sizing: border-box;
  }

  @media screen and (max-width: 767px) {
    .mobileMenu {
      width: 100vw;
    }
  }

  @media screen and (min-width: 768px) and (max-width: 1100px) {
    .mobileMenu {
      width: 50vw;
    }
  }

  @media screen and (min-width: 1101px) {
    .mobileMenu {
      display: none !important;
    }
  }

  .navbarstyles {
    position: sticky;
    top: 0;
    z-index: 20000;
  }

  .close-button {
    display: none;
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255, 255, 255, 0.08);
    border: none;
    font-size: 1.5rem;
    border-radius: 999px;
    color: var(--color-text);
    cursor: pointer;
    width: 2.5rem;
    height: 2.5rem;
  }
</style>


<div class="w-full flex justify-between items-center navbarstyles">
    
    <Astrobar />
  
</div>
<div class="mobileMenu">
    <DropDownMenu  />
</div>