---
import Astrobar from '../components/AstroBar.astro';

import DropDownMenu from '../components/Menu.astro';

---

<style is:global>
  .mobileMenu {
    position: fixed;
    top: 0;
    right: 0;
    transform: translateX(100%);
    height: 100vh;
    background: rgba(3, 6, 15, 0.95);
    backdrop-filter: blur(16px);
    transition: transform 0.3s ease-in-out;
    z-index: 1000;
    overflow-y: auto;
    box-sizing: border-box;
    padding: 4rem 2rem 2rem;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobileMenu.show {
    transform: translateX(0);
  }

  .mobileMenu .menu {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }

  .mobileMenu .menuItem {
    font-size: 1.1rem;
  }

  @media screen and (max-width: 767px) {
    .mobileMenu {
      width: 100vw;
    }
  }

  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .mobileMenu {
      width: 50vw;
    }
  }

  @media screen and (min-width: 1024px) {
    .mobileMenu {
      display: none !important;
    }
  }

  .navbarstyles {
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .close-button {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255, 255, 255, 0.08);
    border: none;
    font-size: 1.5rem;
    border-radius: 999px;
    color: var(--color-text);
    cursor: pointer;
    width: 2.5rem;
    height: 2.5rem;
  }
</style>


<div class="w-full flex justify-between items-center navbarstyles">
    
    <Astrobar />
  
</div>
<div class="mobileMenu">
    <button class="close-button">×</button>
    <DropDownMenu  />
</div>