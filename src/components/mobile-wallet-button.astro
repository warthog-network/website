---
/** Android APK ships via GitHub Releases (same pattern as warthog_extension). */
const MOBILE_WALLET_VERSION = "1.0.21";
const apkUrl = `https://github.com/warthog-network/mobile-wallet/releases/download/v${MOBILE_WALLET_VERSION}/defi-mobile.apk`;
---

<a
  href={apkUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="mobile-wallet-btn"
  title={`Warthog Mobile Wallet v${MOBILE_WALLET_VERSION}`}
>
  <strong>Mobile Wallet</strong>
  <span>Android APK · v{MOBILE_WALLET_VERSION}</span>
</a>

<style>
  .mobile-wallet-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, var(--color-brand), var(--color-brand-strong));
    color: #1f2937;
    text-decoration: none;
    border-radius: 9999px;
    font-family: var(--font-sans);
    box-shadow: 0 10px 20px -5px rgb(253 185 19 / 0.4);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
    width: fit-content;
    min-width: 13rem;
    z-index: 4;
  }

  .mobile-wallet-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 25px -5px rgb(253 185 19 / 0.5);
  }

  .mobile-wallet-btn:active {
    transform: scale(0.97);
  }

  .mobile-wallet-btn strong {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .mobile-wallet-btn span {
    font-size: 0.7rem;
    opacity: 0.9;
    font-weight: 600;
    margin-top: 0.05rem;
  }
</style>