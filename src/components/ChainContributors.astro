---
import ContentDiv from "../components/ContentDiv.jsx";

const specs = [
  { label: "Coin unit", value: "1 WART" },
  { label: "Block time", value: "20 seconds" },
  { label: "Reward", value: "1.5 WART" },
  { label: "Precision", value: "0.00000001 WART (8 digits)" },
  { label: "Halving", value: "≈ every 2 years" },
  { label: "Supply", value: "18,921,599.68464 (~19M)" },
  { label: "Difficulty adjust", value: "Every 8,640 blocks (~2 days)" },
];

const contributorGroups = [
  ["Pumbaa & Rafiki (formerly Timon)", "CoinFuMasterShifu", "Polaire", "Luk"],
  ["M0sh1M0sh1y", "Andrew", "Open-source contributors"],
    ["Losthymns", "Thefunvampire","Captain Pirate", "Balky Bot" ],
];
---

<style>
  .chain-grid {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media (min-width: 900px) {
    .chain-grid {
      grid-template-columns: 0.85fr 1fr;
      align-items: start;
    }
  }

  .spec-card {
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(8, 12, 24, 0.85);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    box-shadow: var(--shadow-card);
  }

  .spec-list {
    display: grid;
    gap: 0.85rem;
  }

  .spec-item {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.08);
    padding-bottom: 0.65rem;
  }

  .spec-item:last-child {
    border-bottom: none;
  }

  .spec-item span:first-child {
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .contributors-card {
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: linear-gradient(135deg, rgba(3, 8, 20, 0.9), rgba(20, 7, 28, 0.8));
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contributors-card ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-text);
  }

  .contributors-card li {
    margin-bottom: 0.35rem;
  }

  .contributors-card p {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>

<section class="section section--surface">
  <ContentDiv>
    <div class="chain-grid">
      <article class="spec-card">
        <p class="section__eyebrow">Network</p>
        <h2 class="section__title">Chain specs</h2>
        <div class="spec-list">
          {
            specs.map((spec) => (
              <div class="spec-item">
                <span>{spec.label}</span>
                <span>{spec.value}</span>
              </div>
            ))
          }
        </div>
      </article>

      <article class="contributors-card">
        <p class="section__eyebrow">Contributors</p>
        <h2 class="section__title">Builders behind Warthog</h2>
        <div class="content-grid">
          {
            contributorGroups.map((group) => (
              <ul>
                {group.map((name) => (
                  <li>{name}</li>
                ))}
              </ul>
            ))
          }
        </div>
        <p>
          This is an open-source effort. Help with C++, Rust, TypeScript, docs, design, or community work.
          Connect with us on Discord if you want to ship something with impact.
        </p>
      </article>
    </div>
  </ContentDiv>
</section>
