      /* Dropdown Button */
.dropbtn {
  background: transparent;
  color: inherit;
  padding: 0;
  font: inherit;
  border: none;
  cursor: pointer;
}

/* The container <div> - needed to position the dropdown content */
.dropdown { 
  font-family: Montserrat;
  font-size: clamp(0.727rem, 1.079vw, 0.875rem);
  font-weight: 400;
  line-height: 1.067rem;
  text-underline-position: from-font;
  text-decoration-skip-ink: none;
  padding-top: .8rem;
  z-index: 1000;
  position: relative;
  display: inline-block;
}

/* Dropdown Content (Hidden by Default) */

.dropdown-content {
  margin-bottom: 10rem;
  display: none;
  position: absolute;
  background-color: #2a2a2a;
  min-width: 300px;
  box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.5);
  z-index: 1;
  border-radius: 4px;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
}
.ghost{
    display: none;
}
@media screen and (max-width: 1100px) {
  .dropdown-content {
    position: relative;
    transform: none;
    box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.5);
    border-radius: 4px;
    margin-top: 0.5rem;
    width: 100%;
    max-width: 100%;
    left: auto;
    top: auto;
    min-width: auto;
    box-sizing: border-box;
  }
  .dropdown{
    display: none;
  }
  .ghost{
    display: block;
    width: 100%;
  }
  .ghost.dropdown {
    width: 100%;
    display: block;
  }
  .mobileMenu .dropdown-content {
    position: relative;
    display: none;
  }
  .mobileMenu .dropdown.active .dropdown-content {
    display: block;
  }
}
/* Links inside the dropdown */
.dropdown-content a {
  color: rgb(255, 255, 255);
  padding: 12px 50px;
  text-decoration: none;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
  box-sizing: border-box;
}
input {
  background: none;
  border: none;
}
/* Change color of dropdown links on hover */
.dropdown-content a:hover {background-color: rgb(245, 208, 0);}

/* Show the dropdown menu on active class */
.dropdown.active .dropdown-content {display: block;}

/* Change the background color of the dropdown button when the dropdown content is shown */
.dropdown.active .dropbtn {background-color: transparent;}
</style>

