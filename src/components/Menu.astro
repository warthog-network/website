        }
        .mobile-social-links {
          display: none !important;
        }
      }

      /* Mobile menu: Show all 4 social links only in mobile menu */
      @media screen and (max-width: 1100px) {
        .desktop-social-links {
          display: none !important;
        }
        .desktop-cycling-social {
          display: none !important;
        }
