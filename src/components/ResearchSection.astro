---
const papers = [
  {
    title: "Whitepaper",
    description:
      "The complete Warthog Network whitepaper — covers the project's vision, architecture, mining (Janushash/PoBW), DeFi (Fair Batch Matching), tokenomics, and roadmap. Auto-built on every commit to the build branch, always up to date.",
    image: "/images/whitepaper-preview.png",
    href: "https://github.com/warthog-network/whitepaper/releases/download/build/main.pdf",
  },
  {
    title: "Proof of Balanced Work",
    description:
      "PoBW introduces a novel cryptographic mining paradigm that combines multiple hash functions multiplicatively. This innovation enables hybrid mining algorithms requiring both CPU and GPU capabilities simultaneously, providing strong ASIC-resistance and promoting energy-efficient mining through balanced hardware configurations.",
    image: "/images/PoBW-preview.png",
    href: "https://raw.githubusercontent.com/CoinFuMasterShifu/ProofOfBalancedWork/main/PoBW.pdf",
  },
  {
    title: "Fair Batch Matching",
    description:
      "FBM is a groundbreaking DeFi matching algorithm that eliminates sandwich attacks and MEV extraction by processing all swap orders jointly within a block. Every participant receives identical pricing regardless of transaction sequence, establishing a Nash equilibrium where manipulation becomes mathematically impossible.",
    image: "/images/FairBatchMatching-preview.png",
    href: "https://raw.githubusercontent.com/CoinFuMasterShifu/FairBatchMatching/main/FairBatchMatching.pdf",
  },
];

const viewerUrl = (pdf, title) =>
  `/paper-viewer?pdf=${encodeURIComponent(pdf)}&title=${encodeURIComponent(title)}`;
---

<style>
  .research-section {
    padding-block: clamp(3rem, 6vw, 5.5rem);
    scroll-margin-top: 5rem;
  }

  .research-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: var(--page-gutter);
  }

  .research-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .research-header h1 {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .subtitle {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 800px;
    margin: 0 auto;
  }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .research-card {
    background: rgba(8, 12, 24, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.75rem;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    text-decoration: none;
    display: block;
  }

  .research-card:hover {
    transform: translateY(-4px);
    border-color: rgba(56, 189, 248, 0.45);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .paper-preview {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1275 / 1651;
    background: rgba(255, 255, 255, 0.04);
  }

  .paper-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .research-card:hover .paper-preview img {
    transform: scale(1.02);
  }

  .view-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .research-card:hover .view-overlay {
    opacity: 1;
  }

  .paper-content {
    padding: 1.5rem;
  }

  .paper-content h2 {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .paper-content p {
    font-family: var(--font-sans);
    font-size: 0.938rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 850px) {
    .research-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<section class="research-section" id="research">
  <div class="research-container">
    <div class="research-header">
      <h1>Whitepaper &amp; Research</h1>
      <p class="subtitle">
        Warthog's whitepaper and research papers represent genuine scientific breakthroughs
        in cryptocurrency, grounded in rigorous mathematical foundations. The core development
        team holds advanced degrees in mathematics, statistics, and computer science from
        top-tier universities.
      </p>
    </div>

    <div class="research-grid">
      {papers.map((paper) => (
        <a href={viewerUrl(paper.href, paper.title)} class="research-card">
          <div class="paper-preview">
            <img src={paper.image} alt={`${paper.title} Preview`} />
            <span class="view-overlay">Click to View</span>
          </div>
          <div class="paper-content">
            <h2>{paper.title}</h2>
            <p>{paper.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>