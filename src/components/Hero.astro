---
import MobileWalletButton from "../components/mobile-wallet-button.astro";
import Dunes from "../BalkyImages/dunes.svg";
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__copy">
      <p class="hero__article">
        <span class="hero__article-bold">How our tech is better?</span>
        <a href="/news" class="hero__article-link">Read our article</a>
      </p>

      <h1 class="hero__title">
        <span class="hero__title-em">Rethinking</span>
        <span class="hero__title-main">The Blockchain</span>
      </h1>

      <p class="hero__lede">
        Warthog's decentralized network empowers individuals with fair, balanced, and synergized CPU/GPU work. It secures hardcoded DeFi and token technologies, eliminating the risks of smart contracts. Our goal is a safer, more efficient blockchain, aligned with the original vision of cryptocurrency: "one CPU, one vote."
      </p>

      <div class="hero__wallet">
        <MobileWalletButton />
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__frame">
        <img
          src={Dunes.src}
          alt="Abstract dunes landscape for Warthog blockchain hero section"
          class="hero__image"
          loading="eager"
          decoding="async"
        />

        <a href="/#wheretobuy" class="hero__btn hero__btn--buy">Where To Buy</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    width: 100%;
    margin-inline: auto;
    padding-block: clamp(0.75rem, 2vw, 1.25rem) clamp(1.5rem, 4vw, 2.5rem);
    padding-inline: 0;
    box-sizing: border-box;
  }

  /* Stacked layout — default below 1250px */
  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    gap: clamp(1.25rem, 3vw, 1.75rem);
    width: 100%;
    text-align: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 42rem;
    box-sizing: border-box;
  }

  .hero__article {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 0.5rem;
    width: fit-content;
    max-width: 100%;
    min-height: 1.75rem;
    margin: 0;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: #f0f0ef;
  }

  .hero__article-bold {
    font-family: "Montserrat", sans-serif;
    font-size: 0.625rem;
    font-weight: 700;
    color: #1e1e1e;
  }

  .hero__article-link {
    font-family: "Montserrat", sans-serif;
    font-size: 0.625rem;
    font-weight: 300;
    color: #6b7280;
    text-decoration: none;
  }

  .hero__article-link:hover,
  .hero__article-link:focus-visible {
    color: #1e1e1e;
    text-decoration: underline;
  }

  .hero__title {
    margin: 0;
    color: #1e1e1e;
    font-family: "Montserrat", sans-serif;
    line-height: 1.05;
  }

  .hero__title-em {
    display: block;
    font-size: clamp(2.25rem, 7vw, 3.3rem);
    font-style: italic;
    font-weight: 700;
  }

  .hero__title-main {
    display: block;
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 400;
  }

  .hero__lede {
    margin: 0;
    width: 100%;
    font-family: "Montserrat", sans-serif;
    font-size: 1rem;
    line-height: 1.45;
    color: #1e1e1e;
    text-wrap: pretty;
  }

  /* Stacked layout — wider copy, fluid type below 1250px */
  @media (max-width: 1249px) {
    .hero__title-em {
      font-size: 2.25rem;
    }

    .hero__title-main {
      font-size: 2rem;
    }

    .hero__lede {
      font-size: clamp(1rem, 2.4vw, 1.25rem);
      line-height: 1.45;
    }
  }

  .hero__wallet {
    display: none;
    justify-content: center;
    width: 100%;
    margin-top: 0.25rem;
  }

  .hero__wallet :global(.mobile-wallet-btn) {
    border-radius: 999px;
  }

  .hero__visual {
    width: 100%;
    max-width: 100%;
  }

  /* Frame matches dunes.svg (831×386) so the pocket anchor stays proportional */
  .hero__frame {
    position: relative;
    width: 100%;
    container-type: inline-size;
    container-name: hero-frame;
  }

  .hero__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-brand);
    color: #1e1e1e;
    font-family: "Montserrat", sans-serif;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 10px 17px -10px rgba(253, 185, 19, 0.4);
    transition: filter 0.2s ease;
    white-space: nowrap;
  }

  .hero__btn:hover,
  .hero__btn:focus-visible {
    filter: brightness(0.95);
  }

  /*
   * Pocket anchor — matched to dunes.svg cutout (831×386).
   * Scale all dimensions from the rendered image width (831px reference).
   */
  .hero__btn--buy {
    position: absolute;
    right: 1.6%;
    bottom: 4%;
    left: auto;
    z-index: 2;
    font-size: calc(100cqw / 51.9375);
    padding: calc(100cqw / 61.1) calc(100cqw / 18.89);
    min-height: calc(100cqw / 17.31);
    border-radius: calc(100cqw / 115.4);
  }

  /* Wide desktop — fixed copy width so line breaks stay consistent */
  @media (min-width: 1250px) {
    .hero {
      padding-block: 0.75rem;
    }

    .hero__inner {
      grid-template-columns: 25rem minmax(0, 1fr);
      align-items: center;
      gap: 1.25rem 2rem;
      text-align: left;
    }

    .hero__copy {
      align-items: flex-start;
      width: 25rem;
      max-width: 25rem;
      min-width: 25rem;
      flex-shrink: 0;
      gap: 0.75rem;
      padding-left: 0;
    }

    .hero__title-em {
      font-size: 3.3rem;
    }

    .hero__title-main {
      font-size: 3rem;
    }

    .hero__lede {
      font-size: 1.25rem;
      line-height: 27px;
    }

    .hero__article {
      justify-content: flex-start;
    }

    .hero__wallet {
      display: flex;
      justify-content: flex-start;
      margin-top: 0.125rem;
    }

    .hero__visual {
      max-width: 50rem;
      justify-self: end;
      width: 100%;
      min-width: 0;
    }
  }
</style>