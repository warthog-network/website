<style>
.hamburger {
  z-index: 1100; /* Above mobile menu */
  position: fixed; /* Change to fixed to stay in place on scroll */
  top: 0; /* Position at the top */
  right: 0; /* Position at the right; adjust if needed for padding/margins */
  cursor: pointer;
  padding: 1.3rem;
}
.hamburger .line {
  display: block;
  width: 40px;
  height: 5px;
  margin-bottom: 10px;
  background-color: #352e2e;
}

