---
import '../styles.css';
import Menu from '../components/Menu.astro';
import Hamburger from './Hamburger.astro';

---

<style>
@keyframes fadeIn {
  0% {
    opacity: 0;
    transform: translateY(-10rem);
  }
  60% {
    opacity: 1;
    transform: translateY(0rem);
  }
  80% {
    transform: translateY(10px);
  }
  100% {
    transform: translateY(0rem);
  }
}
.expanded {
  display: unset;
}

.logo{
 
    width: 16.25rem;
  }

.icon{
    height: 2.5rem;
  }

.animate-fadeIn {
  animation: fadeIn .25s ease-out forwards;
}

.expanded {
  display: unset;
}

@media screen and (min-width: 1024px) {

  .desktopMenu a {
    display: inline-block;
    padding: .5rem;
  }
}

@media screen and (max-width: 1100px) {
    .desktopMenu {
      display: none;
    }

    .desktopMenu a {
      display: flex;
      justify-content: center;
    }
}

/* Hamburger styles*/
.navbartop{
  background-color: rgb(0 0 0 / 0.80);
}

.navbartop {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding-left: clamp(1rem, 4vw, 2rem);
  padding-right: clamp(1rem, 4vw, 2rem);
}

@media screen and (max-width: 1023px) {
  .navbartop {
    padding-left: 1rem;
    padding-right: 1rem;
  }
}

</style>


<nav class="navbartop border-b border-white/50" >
    <a  class="logo animate-fadeIn " href="/"><img class=" logo animate-fadeIn" src="/images/Warthog_2024_Full Logo.svg" alt="logo"/></a>
    <section class="lg:flex w-full justify-between items-center desktopMenu">
        <Menu />
    </section>
    <Hamburger />
</nav>